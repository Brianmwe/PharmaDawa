
'use strict';
// PharmaDawa frontend. Zero dependencies, zero innerHTML, zero inline handlers:
// every piece of dynamic text is inserted as a text node, so injected markup can never execute.
(() => {
  // ---------------------------------------------------------------- config
  const API_BASE = (document.querySelector('meta[name="api-base"]')?.content || '/api').replace(/\/+$/, '');
  const IDLE_MS = 15 * 60 * 1000;      // auto sign-out on shared counters
  const REQUEST_TIMEOUT_MS = 15000;
  const MAX_LINE_QTY = 1000;           // matches the server limit
  const RENDER_CAP = 120;              // max cards/rows drawn at once
  const TOKEN_KEY = 'pd_token';

  const state = {
    token: null,
    user: null,
    cfg: { currency: 'KES', taxRate: 0.05, lowStockThreshold: 10, expiryWarnDays: 60 },
    medicines: [],
    view: 'pos',
    checkingOut: false,
  };
  const cart = new Map();              // medicineId -> quantity (prices always come from the server)
  let checkoutKey = null;              // idempotency key for the current cart
  let redraw = null;                   // repaint function of the active view
  let idleTimer = null;
  let lastRefresh = 0;

  const root = document.getElementById('app');
  const $ = (sel, scope = document) => scope.querySelector(sel);

  // ---------------------------------------------------------------- helpers
  const store = {
    get(k) { try { return sessionStorage.getItem(k); } catch { return null; } },
    set(k, v) { try { sessionStorage.setItem(k, v); } catch { /* storage unavailable */ } },
    del(k) { try { sessionStorage.removeItem(k); } catch { /* ignore */ } },
  };
  const pad = (n) => String(n).padStart(2, '0');
  const localDate = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const addDays = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return localDate(d); };
  const cents = (n) => Math.round(Number(n) * 100);
  const money = (n) => `${state.cfg.currency} ${Number(n).toFixed(2)}`;
  const moneyC = (c) => money(c / 100);
  const medById = (id) => state.medicines.find((m) => m.id === id);
  const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
  const uuid = () => { // crypto.randomUUID() needs HTTPS; getRandomValues works everywhere
    const b = new Uint8Array(16); crypto.getRandomValues(b);
    return Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
  };
  const formatErr = (e) => {
    const base = (e && e.message) || 'Something went wrong.';
    return e && Array.isArray(e.details) && e.details.length ? `${base}: ${e.details.join('; ')}` : base;
  };

  // Safe DOM builder: strings become text nodes. There is deliberately no way to pass raw HTML.
  function append(node, kids) {
    for (const k of kids.flat(Infinity)) {
      if (k === null || k === undefined || k === false) continue;
      node.append(k instanceof Node ? k : document.createTextNode(String(k)));
    }
  }
  function h(tag, attrs, ...kids) {
    const n = document.createElement(tag);
    let value;
    if (attrs) {
      for (const [k, v] of Object.entries(attrs)) {
        if (v === null || v === undefined || v === false) continue;
        if (k === 'value') value = v;
        else if (k === 'class') n.className = v;
        else if (k.startsWith('on') && typeof v === 'function') n.addEventListener(k.slice(2), v);
        else n.setAttribute(k, v === true ? '' : String(v));
      }
    }
    append(n, kids);
    if (value !== undefined) n.value = value; // after children so <select> options exist
    return n;
  }

  function toast(msg, type = 'info') {
    const t = h('div', { class: `toast ${type}`, role: type === 'error' ? 'alert' : 'status' }, msg);
    $('#toasts').append(t);
    setTimeout(() => t.remove(), type === 'error' ? 7000 : 3500);
  }

  // ---------------------------------------------------------------- API
  class ApiError extends Error {
    constructor(status, message, details) { super(message); this.status = status; this.details = details; }
  }

  async function api(path, { method = 'GET', body, auth = true, raw = false, soft401 = false, headers = {} } = {}) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), REQUEST_TIMEOUT_MS);
    const hdrs = { ...headers };
    if (body !== undefined) hdrs['Content-Type'] = 'application/json';
    if (auth && state.token) hdrs.Authorization = `Bearer ${state.token}`;
    let res;
    try {
      res = await fetch(API_BASE + path, {
        method, headers: hdrs, cache: 'no-store', signal: ctrl.signal,
        body: body !== undefined ? JSON.stringify(body) : undefined,
      });
    } catch (e) {
      throw new ApiError(0, e.name === 'AbortError' ? 'The server took too long to respond.' : 'Cannot reach the server. Check your connection.');
    } finally {
      clearTimeout(timer);
    }
    if (res.ok && raw) return res;
    let data = null;
    try { data = await res.json(); } catch { /* non-JSON body */ }
    if (!res.ok) {
      if (res.status === 401 && auth && !soft401 && state.token) logout('Your session has ended. Please sign in again.');
      throw new ApiError(res.status, (data && data.error) || `Request failed (${res.status}).`, data && data.details);
    }
    return data;
  }

  // ---------------------------------------------------------------- session
  function bumpIdle() {
    if (!state.token) return;
    clearTimeout(idleTimer);
    idleTimer = setTimeout(() => logout('Signed out after 15 minutes of inactivity.'), IDLE_MS);
  }
  ['click', 'keydown', 'pointerdown', 'touchstart'].forEach((ev) => document.addEventListener(ev, bumpIdle, { passive: true }));

  function logout(message) {
    state.token = null; state.user = null; state.medicines = [];
    cart.clear(); checkoutKey = null; redraw = null;
    store.del(TOKEN_KEY);
    clearTimeout(idleTimer);
    document.querySelectorAll('dialog').forEach((d) => d.close());
    renderLogin(message);
  }

  async function loadSession() {
    const cfg = await api('/config');
    state.user = cfg.user;
    state.cfg = { currency: cfg.currency, taxRate: cfg.taxRate, lowStockThreshold: cfg.lowStockThreshold, expiryWarnDays: cfg.expiryWarnDays };
    state.medicines = await api('/medicines?limit=5000');
    lastRefresh = Date.now();
  }

  async function refreshMedicines() {
    state.medicines = await api('/medicines?limit=5000');
    lastRefresh = Date.now();
    pruneCart();
    updateHeader();
    if (redraw) redraw();
  }

  // ---------------------------------------------------------------- medicine status
  function statusOf(m) {
    const today = localDate();
    if (m.expiry < today) return { key: 'expired', label: 'Expired', cls: 'bad' };
    if (m.stock <= 0) return { key: 'out', label: 'Out of stock', cls: 'bad' };
    if (m.stock <= state.cfg.lowStockThreshold) return { key: 'low', label: 'Low stock', cls: 'warn' };
    if (m.expiry <= addDays(state.cfg.expiryWarnDays)) return { key: 'expiring', label: 'Expiring soon', cls: 'warn' };
    return { key: 'ok', label: 'In stock', cls: 'ok' };
  }
  const isSellable = (m) => m.stock > 0 && m.expiry >= localDate();
  function matchesFilter(m, f) {
    const today = localDate();
    if (f === 'expired') return m.expiry < today;
    if (m.expiry < today) return false;
    if (f === 'low') return m.stock <= state.cfg.lowStockThreshold;
    if (f === 'expiring') return m.expiry <= addDays(state.cfg.expiryWarnDays);
    return true;
  }
  const matchesQuery = (m, q) => !q || m.name.toLowerCase().includes(q) || m.category.toLowerCase().includes(q) || (m.barcode && m.barcode.toLowerCase() === q);

  function updateHeader() {
    const box = $('#alerts');
    if (!box) return;
    const today = localDate(), soon = addDays(state.cfg.expiryWarnDays);
    let low = 0, exp = 0, expired = 0;
    for (const m of state.medicines) {
      if (m.expiry < today) { if (m.stock > 0) expired++; continue; }
      if (m.stock <= state.cfg.lowStockThreshold) low++;
      if (m.expiry <= soon) exp++;
    }
    box.replaceChildren(
      expired ? h('span', { class: 'badge bad' }, `${expired} expired in stock`) : null,
      exp ? h('span', { class: 'badge warn' }, `${exp} expiring soon`) : null,
      low ? h('span', { class: 'badge warn' }, `${low} low stock`) : null,
    );
  }

  // ---------------------------------------------------------------- dialogs
  function modal(title, content) {
    const dlg = h('dialog', { class: 'modal', 'aria-label': title }, h('h2', null, title), content);
    dlg.addEventListener('close', () => dlg.remove());
    document.body.append(dlg);
    dlg.showModal();
    return dlg;
  }

  // Generic form dialog. onSubmit may throw; its message is shown inside the dialog and the dialog stays open.
  function openForm({ title, intro, fields = [], submitLabel = 'Save', danger = false, onSubmit }) {
    const err = h('p', { class: 'form-error', role: 'alert' });
    const inputs = {};
    const rows = fields.map((f) => {
      const common = { name: f.name, id: `f-${f.name}`, required: f.required !== false, autocomplete: f.autocomplete || 'off' };
      const input = f.type === 'select'
        ? h('select', common, f.options.map((o) => h('option', { value: o.value }, o.label)))
        : h('input', { ...common, type: f.type || 'text', min: f.min, max: f.max, step: f.step, maxlength: f.maxlength, minlength: f.minlength, pattern: f.pattern, title: f.title });
      if (f.value !== undefined && f.value !== null) input.value = f.value;
      inputs[f.name] = input;
      return h('label', { class: 'field' }, h('span', null, f.label), input, f.help ? h('small', null, f.help) : null);
    });
    const cancel = h('button', { type: 'button', class: 'btn', onclick: () => dlg.close() }, 'Cancel');
    const submit = h('button', { type: 'submit', class: `btn ${danger ? 'danger' : 'primary'}` }, submitLabel);
    const form = h('form', {
      onsubmit: async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        err.textContent = '';
        submit.disabled = true; cancel.disabled = true;
        try {
          const values = {};
          for (const [k, el] of Object.entries(inputs)) values[k] = el.value;
          await onSubmit(values);
          dlg.close();
        } catch (ex) {
          err.textContent = formatErr(ex);
          submit.disabled = false; cancel.disabled = false;
        }
      },
    }, intro ? h('p', null, intro) : null, rows, err, h('div', { class: 'actions end' }, cancel, submit));
    const dlg = modal(title, form);
    const first = form.querySelector('input, select');
    if (first) first.focus();
    return dlg;
  }

  // ---------------------------------------------------------------- login
  function renderLogin(message) {
    redraw = null;
    const err = h('p', { class: 'form-error', role: 'alert' }, message || '');
    const user = h('input', { id: 'login-user', name: 'username', autocomplete: 'username', required: true, maxlength: 30, autocapitalize: 'none', spellcheck: 'false' });
    const pass = h('input', { id: 'login-pass', name: 'password', type: 'password', autocomplete: 'current-password', required: true, maxlength: 72 });
    const btn = h('button', { class: 'btn primary block', type: 'submit' }, 'Sign in');
    const form = h('form', {
      class: 'login-card',
      onsubmit: async (e) => {
        e.preventDefault();
        const username = user.value.trim().toLowerCase();
        if (!username || !pass.value) { err.textContent = 'Enter your username and password.'; return; }
        err.textContent = ''; btn.disabled = true; btn.textContent = 'Signing in…';
        try {
          const res = await api('/auth/login', { method: 'POST', body: { username, password: pass.value }, auth: false });
          state.token = res.token;
          store.set(TOKEN_KEY, res.token);
          pass.value = '';
          await loadSession();
          state.view = 'pos';
          renderShell();
          bumpIdle();
        } catch (ex) {
          if (ex.status !== 429 || !state.token) { /* keep message below */ }
          state.token = null; store.del(TOKEN_KEY);
          err.textContent = formatErr(ex);
          btn.disabled = false; btn.textContent = 'Sign in';
        }
      },
    },
    h('span', { class: 'logo', 'aria-hidden': 'true' }, 'Rx'),
    h('h1', null, 'PharmaDawa'),
    h('p', { class: 'sub' }, 'Sign in to the pharmacy system'),
    h('label', { class: 'field' }, h('span', null, 'Username'), user),
    h('label', { class: 'field' }, h('span', null, 'Password'), pass),
    err, btn);
    root.replaceChildren(h('div', { class: 'login-wrap' }, form));
    user.focus();
  }

  // ---------------------------------------------------------------- shell
  const TITLES = { pos: 'Point of Sale', inventory: 'Inventory Management', sales: 'Sales History', users: 'User Management' };

  function renderShell() {
    const isAdmin = state.user.role === 'admin';
    const views = [['pos', 'Point of Sale'], ['inventory', 'Inventory'], ['sales', 'Sales']];
    if (isAdmin) views.push(['users', 'Users']);

    const nav = h('nav', { 'aria-label': 'Main' }, views.map(([key, label]) =>
      h('button', { class: 'nav-btn', type: 'button', 'data-view': key, onclick: () => showView(key) }, label)));
    const sidebar = h('aside', { class: 'sidebar' }, h('div', { class: 'brand' }, h('span', { class: 'logo', 'aria-hidden': 'true' }, 'Rx'), h('span', null, 'PharmaDawa')), nav);
    const topbar = h('header', { class: 'topbar' },
      h('h1', { id: 'page-title' }, TITLES.pos),
      h('div', { class: 'top-right' },
        h('div', { id: 'alerts', class: 'top-right' }),
        h('span', { id: 'clock', class: 'clock' }),
        h('span', { class: 'badge' }, `${state.user.username} · ${state.user.role}`),
        h('button', { class: 'btn small', type: 'button', onclick: changePasswordForm }, 'Change password'),
        h('button', { class: 'btn small', type: 'button', onclick: () => logout('You have been signed out.') }, 'Sign out')));
    root.replaceChildren(h('div', { class: 'app' }, sidebar, h('div', { class: 'main' }, topbar, h('div', { id: 'view', class: 'view' }))));
    updateHeader();
    tickClock();
    showView(views.some(([k]) => k === state.view) ? state.view : 'pos');
  }

  function showView(key) {
    if (key === 'users' && state.user.role !== 'admin') key = 'pos';
    state.view = key;
    redraw = null;
    document.querySelectorAll('.nav-btn').forEach((b) => {
      if (b.dataset.view === key) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
    });
    $('#page-title').textContent = TITLES[key];
    document.title = `${TITLES[key]} - PharmaDawa`;
    const view = { pos: viewPOS, inventory: viewInventory, sales: viewSales, users: viewUsers }[key]();
    $('#view').replaceChildren(view);
  }

  function tickClock() {
    const el = $('#clock');
    if (el) el.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }
  setInterval(tickClock, 15000);

  document.addEventListener('visibilitychange', () => {
    // Stock can change on another terminal while this tab was hidden
    if (document.visibilityState === 'visible' && state.token && Date.now() - lastRefresh > 30000) refreshMedicines().catch(() => {});
  });

  // ---------------------------------------------------------------- POS
  function pruneCart() {
    let changed = false;
    for (const [id, qty] of [...cart]) {
      const m = medById(id);
      if (!m || !isSellable(m)) { cart.delete(id); changed = true; toast(`${m ? m.name : 'An item'} is no longer available and was removed from the cart.`, 'error'); }
      else if (qty > m.stock) { cart.set(id, m.stock); changed = true; toast(`${m.name}: quantity reduced to available stock (${m.stock}).`, 'error'); }
    }
    if (changed) checkoutKey = null;
  }

  function addToCart(id) {
    const m = medById(id);
    if (!m || !isSellable(m)) return;
    const q = cart.get(id) || 0;
    if (q >= m.stock) return toast(`No more stock available for ${m.name}.`, 'error');
    cart.set(id, Math.min(q + 1, MAX_LINE_QTY));
    checkoutKey = null;
    if (redraw) redraw();
  }
  function setQty(id, q) {
    const m = medById(id);
    if (!m || q <= 0) cart.delete(id); else cart.set(id, Math.min(q, m.stock, MAX_LINE_QTY));
    checkoutKey = null;
    if (redraw) redraw();
  }

  function viewPOS() {
    let q = '';
    const grid = h('div', { class: 'catalog-grid' });
    const more = h('p', { class: 'note' });
    const lines = h('div', { class: 'cart-lines' });
    const subEl = h('span'), taxEl = h('span'), totalEl = h('span');
    const payBtn = h('button', { class: 'btn primary block', type: 'button', onclick: checkout }, 'Complete Sale');
    const clearBtn = h('button', { class: 'btn link', type: 'button', onclick: () => { cart.clear(); checkoutKey = null; drawAll(); } }, 'Clear all');

    function medCard(m) {
      const st = statusOf(m);
      const sellable = isSellable(m);
      const inCart = cart.get(m.id) || 0;
      return h('article', { class: `card${sellable ? '' : ' disabled'}` },
        h('span', { class: 'cat' }, m.category),
        h('h3', null, m.name),
        h('p', { class: 'meta' }, 'Stock: ', h('b', { class: m.stock <= state.cfg.lowStockThreshold ? 'low' : '' }, String(m.stock)), ` · Exp ${m.expiry}`),
        h('div', { class: 'card-foot' },
          h('span', { class: 'price' }, money(m.price)),
          st.key === 'ok' ? null : h('span', { class: `badge ${st.cls}` }, st.label),
          h('button', { class: 'btn small primary', type: 'button', disabled: !sellable || inCart >= m.stock, 'aria-label': `Add ${m.name} to cart`, onclick: () => addToCart(m.id) }, '+ Add')));
    }

    function drawCatalog() {
      const matches = state.medicines.filter((m) => matchesQuery(m, q));
      grid.replaceChildren(...(matches.length ? matches.slice(0, RENDER_CAP).map(medCard) : [h('p', { class: 'empty' }, 'No medicines match your search.')]));
      more.textContent = matches.length > RENDER_CAP ? `Showing ${RENDER_CAP} of ${matches.length}. Refine your search to see more.` : '';
    }

    function cartLine(id, qty) {
      const m = medById(id);
      return h('div', { class: 'line' },
        h('div', null, h('p', { class: 'nm' }, m.name), h('p', { class: 'sub' }, `${money(m.price)} each · ${moneyC(cents(m.price) * qty)}`)),
        h('div', { class: 'qty' },
          h('button', { type: 'button', 'aria-label': `Decrease ${m.name}`, onclick: () => setQty(id, qty - 1) }, '−'),
          h('output', null, String(qty)),
          h('button', { type: 'button', 'aria-label': `Increase ${m.name}`, disabled: qty >= m.stock || qty >= MAX_LINE_QTY, onclick: () => setQty(id, qty + 1) }, '+')));
    }

    function drawCart() {
      lines.replaceChildren(...(cart.size ? [...cart].filter(([id]) => medById(id)).map(([id, qty]) => cartLine(id, qty)) : [h('p', { class: 'cart-empty' }, 'Cart is empty')]));
      let sub = 0;
      for (const [id, qty] of cart) { const m = medById(id); if (m) sub += cents(m.price) * qty; }
      const tax = Math.round(sub * state.cfg.taxRate);
      subEl.textContent = moneyC(sub); taxEl.textContent = moneyC(tax); totalEl.textContent = moneyC(sub + tax);
      payBtn.disabled = !cart.size || state.checkingOut;
      clearBtn.disabled = !cart.size;
    }
    function drawAll() { drawCatalog(); drawCart(); }
    redraw = drawAll;

    function scanOrPick(code) {
      if (!code) return;
      const lower = code.toLowerCase();
      const exact = state.medicines.find((m) => m.barcode && m.barcode.toLowerCase() === lower);
      const matches = state.medicines.filter((m) => matchesQuery(m, lower));
      const pick = exact || (matches.length === 1 ? matches[0] : null);
      if (!pick) return toast(matches.length ? 'Several matches. Pick one from the list.' : 'No medicine found.', 'error');
      if (!isSellable(pick)) return toast(`${pick.name} cannot be sold (${statusOf(pick).label.toLowerCase()}).`, 'error');
      addToCart(pick.id);
      search.value = ''; q = ''; drawCatalog();
    }

    const search = h('input', {
      type: 'search', placeholder: 'Search by name or category, or scan a barcode and press Enter…', autocomplete: 'off', maxlength: 100, 'aria-label': 'Search medicines',
      oninput: debounce(() => { q = search.value.trim().toLowerCase(); drawCatalog(); }, 150),
      onkeydown: (e) => { if (e.key === 'Enter') { e.preventDefault(); scanOrPick(search.value.trim()); } },
    });

    const cartEl = h('aside', { class: 'cart', 'aria-label': 'Current sale' },
      h('div', { class: 'cart-head' }, h('h2', null, 'Current Sale'), clearBtn),
      lines,
      h('div', { class: 'totals' },
        h('div', { class: 'row' }, h('span', null, 'Subtotal'), subEl),
        h('div', { class: 'row' }, h('span', null, `Tax (${+(state.cfg.taxRate * 100).toFixed(2)}%)`), taxEl),
        h('div', { class: 'row grand' }, h('span', null, 'Total'), totalEl),
        payBtn,
        h('p', { class: 'note' }, 'Final prices are confirmed by the server when you complete the sale.')));

    const wrap = h('section', { class: 'pos' }, h('div', null, search, grid, more), cartEl);
    drawAll();
    setTimeout(() => search.focus(), 0);
    return wrap;
  }

  async function checkout() {
    if (state.checkingOut || !cart.size) return;
    state.checkingOut = true;
    if (redraw) redraw();
    checkoutKey = checkoutKey || uuid(); // reused on retry so a lost response can never double-charge
    try {
      const items = [...cart].map(([medicineId, quantity]) => ({ medicineId, quantity }));
      const res = await api('/sales', { method: 'POST', body: { items }, headers: { 'Idempotency-Key': checkoutKey } });
      cart.clear(); checkoutKey = null;
      state.checkingOut = false;
      await refreshMedicines().catch(() => {});
      showSaleDone(res.sale, res.replayed);
    } catch (e) {
      toast(e.status === 0 ? `${e.message} Your cart is kept; press Complete Sale again to retry safely.` : formatErr(e), 'error');
      state.checkingOut = false;
      refreshMedicines().catch(() => {});
    } finally {
      state.checkingOut = false;
      if (redraw) redraw();
    }
  }

  function showSaleDone(sale, replayed) {
    const dlg = modal('Sale completed', h('div', { class: 'stack' },
      h('p', null, `Sale #${sale.saleId} · Total ${money(sale.total)}`),
      replayed ? h('p', { class: 'note' }, 'This sale had already been recorded, so nothing was charged twice.') : null,
      h('div', { class: 'actions end' },
        h('button', { class: 'btn', type: 'button', onclick: () => openReceipt(sale.saleId) }, 'Open receipt (PDF)'),
        h('button', { class: 'btn primary', type: 'button', onclick: () => dlg.close() }, 'New sale'))));
  }

  async function openReceipt(id) {
    const win = window.open('about:blank', '_blank'); // opened synchronously so pop-up blockers allow it
    try {
      const res = await api(`/sales/${id}/receipt`, { raw: true });
      const url = URL.createObjectURL(await res.blob());
      if (win) win.location.href = url;
      else h('a', { href: url, download: `PharmaDawa-Receipt-${id}.pdf` }).click();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
    } catch (e) {
      if (win) win.close();
      toast(formatErr(e), 'error');
    }
  }

  // ---------------------------------------------------------------- Inventory
  function medicineForm(m) {
    openForm({
      title: m ? 'Edit medicine' : 'Add medicine',
      submitLabel: m ? 'Save changes' : 'Add medicine',
      fields: [
        { name: 'name', label: 'Name', value: m?.name, minlength: 2, maxlength: 100 },
        { name: 'category', label: 'Category', value: m?.category, maxlength: 50 },
        { name: 'price', label: `Price (${state.cfg.currency})`, type: 'number', value: m?.price, min: '0.01', max: '10000000', step: '0.01' },
        { name: 'stock', label: 'Stock', type: 'number', value: m?.stock, min: '0', max: '10000000', step: '1' },
        { name: 'expiry', label: 'Expiry date', type: 'date', value: m?.expiry, min: m ? undefined : localDate() },
