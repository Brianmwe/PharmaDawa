// POST /api/admin/reset-user-password (Admin Only)
app.post('/api/admin/reset-user-password', authenticateToken, requireRole('admin'), (req, res) => {
  const { targetUsername, newTempPassword } = req.body;

  if (!targetUsername || !newTempPassword) {
    return res.status(400).json({ error: 'Target username and new temporary password are required.' });
  }

  const targetUser = db.prepare('SELECT * FROM users WHERE username = ?').get(targetUsername);
  if (!targetUser) {
    return res.status(404).json({ error: 'Target user does not exist.' });
  }

  const hashedTempPassword = bcrypt.hashSync(newTempPassword, 10);
  db.prepare('UPDATE users SET password = ?, reset_token = NULL, reset_token_expires = NULL WHERE id = ?')
    .run(hashedTempPassword, targetUser.id);

  res.json({ message: `Password for user '${targetUsername}' reset successfully.` });
});
// 1. POST /api/auth/request-password-reset
app.post('/api/auth/request-password-reset', (req, res) => {
  const { username } = req.body;

  const user = db.prepare('SELECT * FROM users WHERE username = ?').get(username);
  if (!user) {
    // Return standard success message to prevent user enumeration attacks
    return res.json({ message: 'If an account exists, a reset token has been generated.' });
  }

  // Generate a random 32-byte hex token valid for 1 hour
  const resetToken = crypto.randomBytes(32).toString('hex');
  const expires = new Date(Date.now() + 3600000).toISOString(); // 1 hour from now

  db.prepare('UPDATE users SET reset_token = ?, reset_token_expires = ? WHERE id = ?')
    .run(resetToken, expires, user.id);

  // In production, send this via SMS/Email. Returned in response for development logging:
  res.json({
    message: 'Reset token generated successfully.',
    resetToken: resetToken // Pass to client or email service
  });
});

// 2. POST /api/auth/reset-password-with-token
app.post('/api/auth/reset-password-with-token', (req, res) => {
  const { token, newPassword } = req.body;

  if (!token || !newPassword) {
    return res.status(400).json({ error: 'Reset token and new password are required.' });
  }

  // Find user with matching active token that has not expired
  const user = db.prepare(
    'SELECT * FROM users WHERE reset_token = ? AND reset_token_expires > ?'
  ).get(token, new Date().toISOString());

  if (!user) {
    return res.status(400).json({ error: 'Invalid or expired password reset token.' });
  }

  // Update password and clear reset token fields
  const hashedPassword = bcrypt.hashSync(newPassword, 10);
  db.prepare(
    'UPDATE users SET password = ?, reset_token = NULL, reset_token_expires = NULL WHERE id = ?'
  ).run(hashedPassword, user.id);

  res.json({ message: 'Password has been reset successfully. You can now log in.' });
});
