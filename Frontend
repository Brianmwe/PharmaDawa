'use strict';
// PharmaDawa server: REST API + static frontend, no npm dependencies.
// Needs Node 22.13+ (built-in node:sqlite). Configuration comes from environment variables (see .env.example).
const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { promisify } = require('node:util');
const { DatabaseSync } = require('node:sqlite');

const scrypt = promisify(crypto.scrypt);
const env = process.env;

// ---------------------------------------------------------------- config
const CFG = {
  port: Number(env.PORT) || 3000,
  host: env.HOST || '127.0.0.1',
  dbPath: env.DB_PATH || path.join(__dirname, 'data', 'pharmadawa.db'),
  jwtSecret: env.JWT_SECRET || '',
  tokenTtlMs: (Number(env.TOKEN_TTL_HOURS) || 12) * 3600 * 1000,
  currency: env.CURRENCY || 'KES',
  taxRate: env.TAX_RATE !== undefined ? Number(env.TAX_RATE) : 0.05,
  lowStockThreshold: Number(env.LOW_STOCK_THRESHOLD) || 10,
  expiryWarnDays: Number(env.EXPIRY_WARN_DAYS) || 60,
  pharmacyName: env.PHARMACY_NAME || 'PharmaDawa Pharmacy',
  trustProxy: env.TRUST_PROXY === 'true',
  seedDemo: env.SEED_DEMO !== undefined ? env.SEED_DEMO === 'true' : env.NODE_ENV !== 'production',
};
const MAX_LINE_QTY = 1000;
const MAX_STOCK = 1_000_000;

function fatal(msg) { console.error(`Config error: ${msg}`); process.exit(1); }
if (CFG.jwtSecret.length < 32) fatal('JWT_SECRET must be a random string of at least 32 characters (run: openssl rand -hex 32).');
if (!Number.isFinite(CFG.taxRate) || CFG.taxRate < 0 || CFG.taxRate > 1) fatal('TAX_RATE must be between 0 and 1 (0.05 = 5%).');

// ---------------------------------------------------------------- small helpers
class HttpError extends Error {
  constructor(status, message, details) { super(message); this.status = status; this.details = details; }
}
const pad = (n) => String(n).padStart(2, '0');
const localDate = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const addDays = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return localDate(d); };
const stamp = (iso) => { const d = new Date(iso); return `${localDate(d)} ${pad(d.getHours())}:${pad(d.getMinutes())}`; };
const nowIso = () => new Date().toISOString();
const isInt = (v, min, max) => Number.isInteger(v) && v >= min && v <= max;
const clampInt = (v, min, max, dflt) => { const n = Number.parseInt(v, 10); return Number.isInteger(n) ? Math.min(Math.max(n, min), max) : dflt; };

function parseId(s) {
  if (!/^\d{1,9}$/.test(s) || Number(s) < 1) throw new HttpError(400, 'Invalid ID.');
  return Number(s);
}
function validDate(s) {
  if (typeof s !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
  const [y, m, d] = s.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}

// ---------------------------------------------------------------- database
fs.mkdirSync(path.dirname(CFG.dbPath), { recursive: true });
const db = new DatabaseSync(CFG.dbPath);
db.exec(`
  PRAGMA journal_mode = WAL;
  PRAGMA synchronous = NORMAL;
  PRAGMA foreign_keys = ON;
  PRAGMA busy_timeout = 5000;

  CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    role TEXT NOT NULL CHECK (role IN ('admin', 'pharmacist')),
    token_version INTEGER NOT NULL DEFAULT 0,
    active INTEGER NOT NULL DEFAULT 1,
    created_at TEXT NOT NULL
  );
  CREATE TABLE IF NOT EXISTS medicines (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    price_c INTEGER NOT NULL CHECK (price_c >= 0),
    stock INTEGER NOT NULL CHECK (stock >= 0),
    expiry TEXT NOT NULL,
    barcode TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_medicines_barcode ON medicines(barcode) WHERE barcode IS NOT NULL;
  CREATE TABLE IF NOT EXISTS sales (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL REFERENCES users(id),
    subtotal_c INTEGER NOT NULL,
    tax_c INTEGER NOT NULL,
    total_c INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    voided_at TEXT,
    void_reason TEXT,
    voided_by INTEGER REFERENCES users(id),
    idem_key TEXT
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_sales_idem ON sales(user_id, idem_key) WHERE idem_key IS NOT NULL;
  CREATE TABLE IF NOT EXISTS sale_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sale_id INTEGER NOT NULL REFERENCES sales(id) ON DELETE CASCADE,
    medicine_id INTEGER NOT NULL REFERENCES medicines(id),
    name TEXT NOT NULL,
    quantity INTEGER NOT NULL,
    unit_price_c INTEGER NOT NULL
  );
  CREATE TABLE IF NOT EXISTS audit_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER,
    username TEXT,
    action TEXT NOT NULL,
    detail TEXT,
    ip TEXT,
    created_at TEXT NOT NULL
  );
`);

const stmtCache = new Map();
const prep = (sql) => { let s = stmtCache.get(sql); if (!s) { s = db.prepare(sql); stmtCache.set(sql, s); } return s; };
const get = (sql, ...p) => prep(sql).get(...p);
const all = (sql, ...p) => prep(sql).all(...p);
const run = (sql, ...p) => prep(sql).run(...p);
function tx(fn) {
  db.exec('BEGIN IMMEDIATE');
  try { const r = fn(); db.exec('COMMIT'); return r; }
  catch (e) { try { db.exec('ROLLBACK'); } catch { /* already rolled back */ } throw e; }
}
const isUniqueErr = (e) => /UNIQUE constraint failed/i.test(String(e && e.message));

function audit(user, action, detail, ip) {
  try { run('INSERT INTO audit_logs (user_id, username, action, detail, ip, created_at) VALUES (?, ?, ?, ?, ?, ?)', user ? user.id : null, user ? user.username : null, action, detail ?? null, ip ?? null, nowIso()); }
  catch (e) { console.error('audit failed:', e.message); }
}

// ---------------------------------------------------------------- passwords & tokens
async function hashPassword(pw) {
  const salt = crypto.randomBytes(16);
  const key = await scrypt(pw, salt, 64);
  return `scrypt$${salt.toString('base64')}$${key.toString('base64')}`;
}
async function verifyPassword(pw, stored) {
  const [alg, s, k] = String(stored).split('$');
  if (alg !== 'scrypt' || !s || !k) return false;
  const key = await scrypt(pw, Buffer.from(s, 'base64'), 64);
  const expected = Buffer.from(k, 'base64');
  return key.length === expected.length && crypto.timingSafeEqual(key, expected);
}
let dummyHash;
const getDummyHash = async () => (dummyHash ??= await hashPassword(crypto.randomBytes(12).toString('hex')));

const b64u = (v) => Buffer.from(v).toString('base64url');
const hmac = (data) => crypto.createHmac('sha256', CFG.jwtSecret).update(data).digest('base64url');
function signToken(u) {
  const head = b64u(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
  const body = b64u(JSON.stringify({ sub: u.id, tv: u.token_version, exp: Date.now() + CFG.tokenTtlMs }));
  return `${head}.${body}.${hmac(`${head}.${body}`)}`;
}
function verifyToken(token) {
  const parts = String(token).split('.');
  if (parts.length !== 3) return null;
  const given = Buffer.from(parts[2]);
  const expected = Buffer.from(hmac(`${parts[0]}.${parts[1]}`));
  if (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return null;
  try {
    const p = JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8'));
    return p && p.exp > Date.now() ? p : null;
  } catch { return null; }
}
function authenticate(req) {
  const m = /^Bearer (.+)$/.exec(req.headers.authorization || '');
  const p = m && verifyToken(m[1]);
  const u = p && get('SELECT id, username, role, token_version, active FROM users WHERE id = ?', p.sub);
  if (!u || !u.active || u.token_version !== p.tv) throw new HttpError(401, 'Your session has ended. Please sign in again.');
  return u;
}
const userOut = (u) => ({ id: u.id, username: u.username, role: u.role });

// ---------------------------------------------------------------- brute-force protection
const MAX_FAILS = 5;
const LOCK_WINDOW_MS = 15 * 60 * 1000;
const attempts = new Map(); // "ip|username" -> { n, reset }
function lockedFor(key) {
  const a = attempts.get(key);
  if (!a) return 0;
  if (Date.now() > a.reset) { attempts.delete(key); return 0; }
  return a.n >= MAX_FAILS ? a.reset - Date.now() : 0;
}
function recordFail(key) {
  const a = attempts.get(key);
  if (!a || Date.now() > a.reset) {
    if (attempts.size > 10000) attempts.delete(attempts.keys().next().value);
    attempts.set(key, { n: 1, reset: Date.now() + LOCK_WINDOW_MS });
  } else a.n++;
}
setInterval(() => { const t = Date.now(); for (const [k, a] of attempts) if (t > a.reset) attempts.delete(k); }, 60_000).unref();

// ---------------------------------------------------------------- router
const routes = [];
function route(method, pattern, opts, handler) {
  if (typeof opts === 'function') { handler = opts; opts = {}; }
  const keys = [];
  const re = new RegExp(`^${pattern.replace(/:(\w+)/g, (_, k) => { keys.push(k); return '([^/]+)'; })}$`);
  routes.push({ method, re, keys, opts, handler });
}
const ADMIN = { roles: ['admin'] };
const PUBLIC = { public: true };
const raw = (body, headers) => ({ __raw: true, body, headers });

function readJson(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    req.on('data', (c) => { size += c.length; if (size <= 1_000_000) chunks.push(c); });
    req.on('error', reject);
    req.on('end', () => {
      if (size > 1_000_000) return reject(new HttpError(413, 'Request is too large.'));
      if (!size) return resolve({});
      try {
        const v = JSON.parse(Buffer.concat(chunks).toString('utf8'));
        if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error('not an object');
        resolve(v);
      } catch { reject(new HttpError(400, 'Malformed JSON in request body.')); }
    });
  });
}

function clientIp(req) {
  if (CFG.trustProxy) { const f = req.headers['x-forwarded-for']; if (f) return String(f).split(',')[0].trim(); }
  return req.socket.remoteAddress || 'unknown';
}

function sendJson(res, status, body, extra = {}) {
  const data = JSON.stringify(body);
  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Content-Length': Buffer.byteLength(data), 'Cache-Control': 'no-store', ...extra });
  res.end(data);
}
function sendError(res, e) {
  if (res.headersSent) return res.end();
  if (e instanceof HttpError) return sendJson(res, e.status, { success: false, error: e.message, ...(e.details ? { details: e.details } : {}) });
  console.error('Unhandled error:', e);
  sendJson(res, 500, { success: false, error: 'Something went wrong on the server. Please try again.' });
}

async function handleApi(req, res, url) {
  const method = req.method === 'HEAD' ? 'GET' : req.method;
  let hit = null;
  for (const r of routes) {
    if (r.method !== method) continue;
    const m = r.re.exec(url.pathname);
    if (m) { hit = { r, m }; break; }
  }
  if (!hit) throw new HttpError(404, 'Not found.');
  const params = {};
  hit.r.keys.forEach((k, i) => { try { params[k] = decodeURIComponent(hit.m[i + 1]); } catch { throw new HttpError(400, 'Bad request.'); } });
  const ctx = { req, res, params, query: url.searchParams, ip: clientIp(req), user: null, body: {}, status: 200 };
  if (!hit.r.opts.public) {
    ctx.user = authenticate(req);
    if (hit.r.opts.roles && !hit.r.opts.roles.includes(ctx.user.role)) throw new HttpError(403, "You don't have permission to do that.");
  }
  if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) ctx.body = await readJson(req);
  const out = await hit.r.handler(ctx);
  if (out && out.__raw) { res.writeHead(ctx.status, { 'Cache-Control': 'no-store', 'Content-Length': out.body.length, ...out.headers }); return res.end(out.body); }
  sendJson(res, ctx.status, out);
}

// ---------------------------------------------------------------- shapes & validation
const medOut = (r) => ({ id: r.id, name: r.name, category: r.category, price: r.price_c / 100, stock: r.stock, expiry: r.expiry, barcode: r.barcode });

function parseMedicine(b, { requireFuture }) {
  const errs = [];
  const name = typeof b.name === 'string' ? b.name.trim() : '';
  const category = typeof b.category === 'string' ? b.category.trim() : '';
  if (!name || name.length > 120) errs.push('Name is required (up to 120 characters)');
  if (!category || category.length > 60) errs.push('Category is required (up to 60 characters)');
  if (typeof b.price !== 'number' || !Number.isFinite(b.price) || b.price < 0 || b.price > 10_000_000) errs.push('Price must be a number of 0 or more');
  if (!isInt(b.stock, 0, MAX_STOCK)) errs.push('Stock must be a whole number of 0 or more');
  if (!validDate(b.expiry)) errs.push('Expiry must be a real date (YYYY-MM-DD)');
  else if (requireFuture && b.expiry < localDate()) errs.push("Expiry date is in the past. Expired stock can't be added");
  let barcode = null;
  if (b.barcode !== undefined && b.barcode !== null && b.barcode !== '') {
    barcode = typeof b.barcode === 'string' ? b.barcode.trim() : '';
    if (!barcode || barcode.length > 64) errs.push('Barcode must be 1 to 64 characters');
  }
  if (errs.length) throw new HttpError(400, 'Please check the medicine details', errs);
  return { name, category, price_c: Math.round(b.price * 100), stock: b.stock, expiry: b.expiry, barcode };
}
const barcodeTaken = (barcode, exceptId = 0) => barcode && get('SELECT id FROM medicines WHERE barcode = ? AND id <> ?', barcode, exceptId);

function loadSale(id) {
  const s = get('SELECT s.*, u.username AS cashier FROM sales s JOIN users u ON u.id = s.user_id WHERE s.id = ?', id);
  if (!s) return null;
  const items = all('SELECT medicine_id, name, quantity, unit_price_c FROM sale_items WHERE sale_id = ? ORDER BY id', id);
  return saleOut(s, items);
}
function saleOut(s, items) {
  return {
    saleId: s.id, id: s.id, cashier: s.cashier,
    subtotal: s.subtotal_c / 100, tax: s.tax_c / 100, total: s.total_c / 100,
    createdAt: s.created_at, voided: Boolean(s.voided_at), status: s.voided_at ? 'voided' : 'paid',
    voidReason: s.void_reason || null,
    ...(items ? { items: items.map((i) => ({ medicineId: i.medicine_id, name: i.name, quantity: i.quantity, unitPrice: i.unit_price_c / 100, lineTotal: (i.unit_price_c * i.quantity) / 100 })) } : {}),
  };
}

// ---------------------------------------------------------------- receipts (tiny hand-written PDF, no libraries)
function buildPdf(lines) {
  const esc = (s) => String(s).replace(/[^\x20-\x7E]/g, '?').replace(/([\\()])/g, '\\$1');
  const lh = 11;
  const width = 226; // ~80 mm thermal roll
  const height = Math.max(180, 36 + lines.length * lh);
  const content = `BT /F1 8 Tf ${lh} TL 12 ${height - 22} Td\n${lines.map((l) => `(${esc(l)}) Tj T*`).join('\n')}\nET`;
  const objs = [
    '<< /Type /Catalog /Pages 2 0 R >>',
    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
    `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${width} ${height}] /Contents 5 0 R /Resources << /Font << /F1 4 0 R >> >> >>`,
    '<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>',
    `<< /Length ${Buffer.byteLength(content)} >>\nstream\n${content}\nendstream`,
  ];
  let out = '%PDF-1.4\n';
  const offsets = [];
  objs.forEach((o, i) => { offsets.push(Buffer.byteLength(out)); out += `${i + 1} 0 obj\n${o}\nendobj\n`; });
  const xref = Buffer.byteLength(out);
  out += `xref\n0 ${objs.length + 1}\n0000000000 65535 f \n${offsets.map((o) => `${String(o).padStart(10, '0')} 00000 n \n`).join('')}`;
  out += `trailer\n<< /Size ${objs.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`;
  return Buffer.from(out, 'latin1');
}
function receiptLines(s) {
  const W = 38;
  const fmt = (n) => `${CFG.currency} ${n.toFixed(2)}`;
  const center = (t) => ' '.repeat(Math.max(0, Math.floor((W - t.length) / 2))) + t;
  const row = (l, r) => l + ' '.repeat(Math.max(1, W - l.length - r.length)) + r;
  const L = [center(CFG.pharmacyName), center(`Receipt #${s.saleId}`), center(stamp(s.createdAt))];
  if (s.voided) L.push(center('*** VOIDED ***'));
  L.push(`Cashier: ${s.cashier}`, '-'.repeat(W));
  for (const i of s.items) {
    L.push(i.name.length > W ? `${i.name.slice(0, W - 1)}.` : i.name);
    L.push(row(`  ${i.quantity} x ${fmt(i.unitPrice)}`, fmt(i.lineTotal)));
  }
  L.push('-'.repeat(W), row('Subtotal', fmt(s.subtotal)), row(`Tax (${Math.round(CFG.taxRate * 1000) / 10}%)`, fmt(s.tax)), row('TOTAL', fmt(s.total)), '', center('Thank you. Get well soon.'));
  return L;
}

// ---------------------------------------------------------------- routes: public & session
route('GET', '/api/health', PUBLIC, () => { get('SELECT 1'); return { status: 'ok' }; });

async function loginHandler(ctx) {
  const username = typeof ctx.body.username === 'string' ? ctx.body.username.trim().toLowerCase() : '';
  const password = typeof ctx.body.password === 'string' ? ctx.body.password : '';
  if (!username || !password || username.length > 64 || password.length > 200) throw new HttpError(400, 'Enter your username and password.');
  const key = `${ctx.ip}|${username}`;
  const wait = lockedFor(key);
  if (wait) {
    ctx.res.setHeader('Retry-After', Math.ceil(wait / 1000));
    throw new HttpError(429, `Too many failed attempts. Try again in ${Math.ceil(wait / 60000)} minute(s).`);
  }
  const u = get('SELECT * FROM users WHERE username = ?', username);
  const ok = await verifyPassword(password, u ? u.password_hash : await getDummyHash()); // same work either way
  if (!u || !u.active || !ok) {
    recordFail(key);
    audit(null, 'login_failed', username, ctx.ip);
    throw new HttpError(401, 'Wrong username or password.');
  }
  attempts.delete(key);
  audit(u, 'login', null, ctx.ip);
  return { success: true, token: signToken(u), user: userOut(u) };
}
route('POST', '/api/auth/login', PUBLIC, loginHandler);
route('POST', '/api/login', PUBLIC, loginHandler); // legacy alias

route('GET', '/api/config', (ctx) => ({
  success: true, user: userOut(ctx.user), currency: CFG.currency, taxRate: CFG.taxRate,
  lowStockThreshold: CFG.lowStockThreshold, expiryWarnDays: CFG.expiryWarnDays, pharmacyName: CFG.pharmacyName,
}));

route('POST', '/api/auth/change-password', async (ctx) => {
  const { currentPassword, newPassword } = ctx.body;
  if (typeof currentPassword !== 'string' || typeof newPassword !== 'string') throw new HttpError(400, 'Enter your current and new password.');
  if (newPassword.length < 8 || newPassword.length > 72) throw new HttpError(400, 'The new password must be 8 to 72 characters.');
  const row = get('SELECT * FROM users WHERE id = ?', ctx.user.id);
  // 400, not 401: the app signs people out on any 401
  if (!(await verifyPassword(currentPassword, row.password_hash))) throw new HttpError(400, 'Your current password is incorrect.');
  if (newPassword === currentPassword) throw new HttpError(400, 'Choose a password different from the current one.');
  run('UPDATE users SET password_hash = ?, token_version = token_version + 1 WHERE id = ?', await hashPassword(newPassword), row.id);
  audit(ctx.user, 'password_changed', null, ctx.ip);
  return { success: true, token: signToken(get('SELECT * FROM users WHERE id = ?', row.id)) };
});

// ---------------------------------------------------------------- routes: medicines
route('GET', '/api/medicines', (ctx) => {
  const term = (ctx.query.get('q') || '').trim();
  const limit = clampInt(ctx.query.get('limit'), 1, 5000, 1000);
  const rows = term
    ? all("SELECT * FROM medicines WHERE name LIKE ? ESCAPE '\\' OR category LIKE ? ESCAPE '\\' OR barcode = ? ORDER BY name COLLATE NOCASE LIMIT ?",
      `%${term.replace(/[\\%_]/g, '\\$&')}%`, `%${term.replace(/[\\%_]/g, '\\$&')}%`, term, limit)
    : all('SELECT * FROM medicines ORDER BY name COLLATE NOCASE LIMIT ?', limit);
  return rows.map(medOut);
});

route('GET', '/api/medicines/barcode/:code', (ctx) => {
  const r = get('SELECT * FROM medicines WHERE barcode = ?', ctx.params.code);
  if (!r) throw new HttpError(404, 'No medicine has that barcode.');
  return { success: true, ...medOut(r), sellable: r.stock > 0 && r.expiry >= localDate() };
});

route('POST', '/api/medicines', ADMIN, (ctx) => {
  const m = parseMedicine(ctx.body, { requireFuture: true });
  if (barcodeTaken(m.barcode)) throw new HttpError(409, 'Another medicine already uses that barcode.');
  const t = nowIso();
  try {
    const { lastInsertRowid } = run('INSERT INTO medicines (name, category, price_c, stock, expiry, barcode, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)', m.name, m.category, m.price_c, m.stock, m.expiry, m.barcode, t, t);
    audit(ctx.user, 'medicine_created', `${m.name} (id ${lastInsertRowid})`, ctx.ip);
    ctx.status = 201;
    return { success: true, ...medOut(get('SELECT * FROM medicines WHERE id = ?', Number(lastInsertRowid))) };
  } catch (e) {
    if (isUniqueErr(e)) throw new HttpError(409, 'Another medicine already uses that barcode.');
    throw e;
  }
});

route('PUT', '/api/medicines/:id', ADMIN, (ctx) => {
  const id = parseId(ctx.params.id);
  if (!get('SELECT id FROM medicines WHERE id = ?', id)) throw new HttpError(404, 'Medicine not found.');
  const m = parseMedicine(ctx.body, { requireFuture: false }); // editing may legitimately record an expired batch
  if (barcodeTaken(m.barcode, id)) throw new HttpError(409, 'Another medicine already uses that barcode.');
  try {
    run('UPDATE medicines SET name = ?, category = ?, price_c = ?, stock = ?, expiry = ?, barcode = ?, updated_at = ? WHERE id = ?', m.name, m.category, m.price_c, m.stock, m.expiry, m.barcode, nowIso(), id);
  } catch (e) {
    if (isUniqueErr(e)) throw new HttpError(409, 'Another medicine already uses that barcode.');
    throw e;
  }
  audit(ctx.user, 'medicine_updated', `${m.name} (id ${id})`, ctx.ip);
  return { success: true, ...medOut(get('SELECT * FROM medicines WHERE id = ?', id)) };
});

route('POST', '/api/medicines/:id/restock', ADMIN, (ctx) => {
  const id = parseId(ctx.params.id);
  const qty = ctx.body.quantity;
  if (!isInt(qty, 1, 100000)) throw new HttpError(400, 'Quantity must be a whole number between 1 and 100000.');
  const r = get('SELECT * FROM medicines WHERE id = ?', id);
  if (!r) throw new HttpError(404, 'Medicine not found.');
  if (r.stock + qty > MAX_STOCK) throw new HttpError(400, `Stock can't go above ${MAX_STOCK}.`);
  run('UPDATE medicines SET stock = stock + ?, updated_at = ? WHERE id = ?', qty, nowIso(), id);
  audit(ctx.user, 'restock', `${r.name} +${qty}`, ctx.ip);
  const fresh = get('SELECT * FROM medicines WHERE id = ?', id);
  return { success: true, stock: fresh.stock, medicine: medOut(fresh) };
});

// ---------------------------------------------------------------- routes: sales
route('POST', '/api/sales', (ctx) => {
  const { items } = ctx.body;
  if (!Array.isArray(items) || !items.length || items.length > 100) throw new HttpError(400, 'Add at least one item to the sale.');
  const lines = new Map(); // merge duplicate lines so stock is checked against the total
  for (const it of items) {
    if (!it || !isInt(it.medicineId, 1, 2 ** 31) || !isInt(it.quantity, 1, MAX_LINE_QTY)) throw new HttpError(400, `Each item needs a valid medicine and a quantity from 1 to ${MAX_LINE_QTY}.`);
    lines.set(it.medicineId, (lines.get(it.medicineId) || 0) + it.quantity);
  }
  const key = String(ctx.req.headers['idempotency-key'] || '');
  const idem = /^[A-Za-z0-9_-]{8,64}$/.test(key) ? key : null;
  if (idem) { // a retry of the same checkout returns the original sale instead of charging twice
    const prev = get('SELECT id FROM sales WHERE user_id = ? AND idem_key = ?', ctx.user.id, idem);
    if (prev) return { success: true, replayed: true, sale: loadSale(prev.id) };
  }
  const today = localDate();
  const saleId = tx(() => {
    let subtotal = 0;
    const priced = [];
    for (const [id, qty] of lines) {
      const m = get('SELECT * FROM medicines WHERE id = ?', id);
      if (!m) throw new HttpError(400, `Medicine #${id} was not found.`);
      if (m.expiry < today) throw new HttpError(400, `${m.name} has expired and can't be sold.`);
      if (qty > MAX_LINE_QTY) throw new HttpError(400, `You can sell at most ${MAX_LINE_QTY} of one medicine at a time.`);
      if (m.stock < qty) throw new HttpError(400, `Only ${m.stock} of ${m.name} left in stock.`);
      subtotal += m.price_c * qty; // always the server's price, never the client's
      priced.push({ m, qty });
    }
    const tax = Math.round(subtotal * CFG.taxRate);
    const { lastInsertRowid } = run('INSERT INTO sales (user_id, subtotal_c, tax_c, total_c, created_at, idem_key) VALUES (?, ?, ?, ?, ?, ?)', ctx.user.id, subtotal, tax, subtotal + tax, nowIso(), idem);
    for (const { m, qty } of priced) {
      run('INSERT INTO sale_items (sale_id, medicine_id, name, quantity, unit_price_c) VALUES (?, ?, ?, ?, ?)', lastInsertRowid, m.id, m.name, qty, m.price_c);
      if (run('UPDATE medicines SET stock = stock - ?, updated_at = ? WHERE id = ? AND stock >= ?', qty, nowIso(), m.id, qty).changes !== 1) throw new HttpError(400, `Stock for ${m.name} just changed. Please try again.`);
    }
    return Number(lastInsertRowid);
  });
  audit(ctx.user, 'sale_created', `sale #${saleId}`, ctx.ip);
  ctx.status = 201;
  return { success: true, sale: loadSale(saleId) };
});

route('GET', '/api/sales', (ctx) => {
  const limit = clampInt(ctx.query.get('limit'), 1, 500, 200);
  const base = 'SELECT s.*, u.username AS cashier FROM sales s JOIN users u ON u.id = s.user_id';
  const rows = ctx.user.role === 'admin'
    ? all(`${base} ORDER BY s.id DESC LIMIT ?`, limit)
    : all(`${base} WHERE s.user_id = ? ORDER BY s.id DESC LIMIT ?`, ctx.user.id, limit);
  return rows.map((s) => saleOut(s));
});

function ownSale(ctx) {
  const sale = loadSale(parseId(ctx.params.id));
  if (!sale) throw new HttpError(404, 'Sale not found.');
  if (ctx.user.role !== 'admin' && sale.cashier !== ctx.user.username) throw new HttpError(403, "You don't have permission to view that sale.");
  return sale;
}
route('GET', '/api/sales/:id/receipt', (ctx) => {
  const sale = ownSale(ctx);
  return raw(buildPdf(receiptLines(sale)), { 'Content-Type': 'application/pdf', 'Content-Disposition': `inline; filename="receipt-${sale.saleId}.pdf"` });
});

route('POST', '/api/sales/:id/void', ADMIN, (ctx) => {
  const id = parseId(ctx.params.id);
  const reason = typeof ctx.body.reason === 'string' ? ctx.body.reason.trim() : '';
  if (reason.length < 3 || reason.length > 200) throw new HttpError(400, 'Enter a reason (3 to 200 characters).');
  tx(() => {
    const s = get('SELECT * FROM sales WHERE id = ?', id);
    if (!s) throw new HttpError(404, 'Sale not found.');
    if (s.voided_at) throw new HttpError(409, 'That sale was already voided.');
    for (const i of all('SELECT medicine_id, quantity FROM sale_items WHERE sale_id = ?', id)) {
      run('UPDATE medicines SET stock = stock + ?, updated_at = ? WHERE id = ?', i.quantity, nowIso(), i.medicine_id);
    }
    run('UPDATE sales SET voided_at = ?, void_reason = ?, voided_by = ? WHERE id = ?', nowIso(), reason, ctx.user.id, id);
  });
  audit(ctx.user, 'sale_voided', `sale #${id}: ${reason}`, ctx.ip);
  return { success: true, sale: loadSale(id) };
});

// ---------------------------------------------------------------- routes: dashboard, users, audit log
route('GET', '/api/dashboard/stats', (ctx) => {
  const day = new Date(); day.setHours(0, 0, 0, 0);
  const today = localDate();
  const soon = addDays(CFG.expiryWarnDays);
  const mine = ctx.user.role === 'admin' ? 0 : ctx.user.id; // pharmacists see their own takings; 0 means everyone
  const sales = get('SELECT COUNT(*) AS n, COALESCE(SUM(total_c), 0) AS total FROM sales WHERE created_at >= ? AND voided_at IS NULL AND (? = 0 OR user_id = ?)', day.toISOString(), mine, mine);
  const m = get(
    `SELECT COUNT(*) AS total,
       COALESCE(SUM(CASE WHEN expiry >= ? AND stock <= ? THEN 1 ELSE 0 END), 0) AS low,
       COALESCE(SUM(CASE WHEN expiry >= ? AND expiry <= ? THEN 1 ELSE 0 END), 0) AS expiring,
       COALESCE(SUM(CASE WHEN expiry < ? AND stock > 0 THEN 1 ELSE 0 END), 0) AS expired
     FROM medicines`, today, CFG.lowStockThreshold, today, soon, today);
  return { success: true, today: { sales: sales.n, revenue: sales.total / 100 }, medicines: { total: m.total, lowStock: m.low, expiringSoon: m.expiring, expiredInStock: m.expired } };
});

route('GET', '/api/users', ADMIN, () =>
  all('SELECT id, username, role, created_at FROM users WHERE active = 1 ORDER BY username').map((u) => ({ ...userOut(u), createdAt: u.created_at })));

route('POST', '/api/users', ADMIN, async (ctx) => {
  const username = typeof ctx.body.username === 'string' ? ctx.body.username.trim().toLowerCase() : '';
  const password = ctx.body.password;
  const role = ctx.body.role === 'admin' ? 'admin' : 'pharmacist';
  if (!/^[a-z0-9._-]{3,30}$/.test(username)) throw new HttpError(400, 'Username must be 3 to 30 letters, numbers, dots, dashes or underscores.');
  if (typeof password !== 'string' || password.length < 8 || password.length > 72) throw new HttpError(400, 'Password must be 8 to 72 characters.');
  if (get('SELECT id FROM users WHERE username = ?', username)) throw new HttpError(409, 'That username is already taken.');
  const { lastInsertRowid } = run('INSERT INTO users (username, password_hash, role, created_at) VALUES (?, ?, ?, ?)', username, await hashPassword(password), role, nowIso());
  audit(ctx.user, 'user_created', `${username} (${role})`, ctx.ip);
  ctx.status = 201;
  return { success: true, id: Number(lastInsertRowid), username, role };
});

route('DELETE', '/api/users/:id', ADMIN, (ctx) => {
  const id = parseId(ctx.params.id);
  if (id === ctx.user.id) throw new HttpError(400, "You can't remove your own account.");
  const u = get('SELECT * FROM users WHERE id = ? AND active = 1', id);
  if (!u) throw new HttpError(404, 'User not found.');
  if (u.role === 'admin' && get("SELECT COUNT(*) AS n FROM users WHERE role = 'admin' AND active = 1").n <= 1) throw new HttpError(400, "You can't remove the last admin.");
  run('UPDATE users SET active = 0, token_version = token_version + 1 WHERE id = ?', id); // soft delete keeps sales history intact
  audit(ctx.user, 'user_removed', u.username, ctx.ip);
  return { success: true };
});

route('GET', '/api/audit-logs', ADMIN, (ctx) =>
  all('SELECT id, username, action, detail, ip, created_at FROM audit_logs ORDER BY id DESC LIMIT ?', clampInt(ctx.query.get('limit'), 1, 1000, 200))
    .map((a) => ({ id: a.id, username: a.username, action: a.action, detail: a.detail, ip: a.ip, createdAt: a.created_at })));

// ---------------------------------------------------------------- static frontend
const PUBLIC_DIR = path.join(__dirname, 'public');
const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8', '.svg': 'image/svg+xml', '.png': 'image/png', '.ico': 'image/x-icon', '.json': 'application/json; charset=utf-8', '.webmanifest': 'application/manifest+json' };
const plain = (res, status, text) => { res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8' }); res.end(text); };

function serveStatic(req, res, url) {
  if (req.method !== 'GET' && req.method !== 'HEAD') { res.writeHead(405, { Allow: 'GET, HEAD' }); return res.end(); }
  let rel;
  try { rel = decodeURIComponent(url.pathname); } catch { return plain(res, 400, 'Bad request'); }
  if (rel.includes('\0')) return plain(res, 400, 'Bad request');
  if (rel.endsWith('/')) rel += 'index.html';
  const file = path.normalize(path.join(PUBLIC_DIR, rel));
  if (!file.startsWith(PUBLIC_DIR + path.sep)) return plain(res, 403, 'Forbidden');
  fs.readFile(file, (err, data) => {
    if (err) return plain(res, 404, 'Not found');
    const ext = path.extname(file).toLowerCase();
    res.writeHead(200, {
      'Content-Type': MIME[ext] || 'application/octet-stream',
      'Content-Length': data.length,
      'Cache-Control': ext === '.html' ? 'no-cache' : 'public, max-age=300',
    });
    res.end(req.method === 'HEAD' ? undefined : data);
  });
}

// ---------------------------------------------------------------- bootstrap & server
async function bootstrap() {
  if (!get("SELECT id FROM users WHERE role = 'admin' AND active = 1 LIMIT 1")) {
    const pw = env.ADMIN_PASSWORD;
    if (!pw || pw.length < 8) fatal('No admin account exists yet. Set ADMIN_PASSWORD (8+ characters) for the first start.');
    const username = (env.ADMIN_USERNAME || 'admin').trim().toLowerCase();
    run('INSERT INTO users (username, password_hash, role, created_at) VALUES (?, ?, ?, ?)', username, await hashPassword(pw), 'admin', nowIso());
    console.log(`Created admin account "${username}". You can now remove ADMIN_PASSWORD from the environment.`);
  }
  if (CFG.seedDemo && get('SELECT COUNT(*) AS n FROM medicines').n === 0) {
    const demo = [
      ['Paracetamol 500mg', 'Pain relief', 4, 120, addDays(540), '6001000000011'],
      ['Ibuprofen 400mg', 'Pain relief', 9, 80, addDays(400), '6001000000028'],
      ['Amoxicillin 500mg', 'Antibiotics', 25, 60, addDays(300), '6001000000035'],
      ['Cetirizine 10mg', 'Allergy', 12, 45, addDays(45), '6001000000042'],
      ['Oral Rehydration Salts', 'Digestive health', 30, 6, addDays(400), '6001000000059'],
      ['Vitamin C 1000mg', 'Supplements', 18, 90, addDays(600), '6001000000066'],
    ];
    const t = nowIso();
    for (const [n, c, p, s, e, b] of demo) run('INSERT INTO medicines (name, category, price_c, stock, expiry, barcode, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)', n, c, p * 100, s, e, b, t, t);
    console.log('Loaded demo medicines (set SEED_DEMO=false to skip this).');
  }
}

const server = http.createServer(async (req, res) => {
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'DENY');
  res.setHeader('Referrer-Policy', 'no-referrer');
  res.setHeader('Content-Security-Policy', "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'");
  try {
    let url;
    try { url = new URL(req.url, 'http://localhost'); } catch { return plain(res, 400, 'Bad request'); }
    if (url.pathname.startsWith('/api/')) await handleApi(req, res, url);
    else serveStatic(req, res, url);
  } catch (e) { sendError(res, e); }
});
server.keepAliveTimeout = 65_000;

function shutdown(signal) {
  console.log(`${signal} received, shutting down...`);
  server.close(() => { try { db.close(); } catch { /* ignore */ } process.exit(0); });
  server.closeAllConnections();
  setTimeout(() => process.exit(1), 5000).unref();
}
process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));
process.on('uncaughtException', (e) => { console.error('Uncaught exception:', e); process.exit(1); }); // the service manager restarts us
process.on('unhandledRejection', (e) => { console.error('Unhandled rejection:', e); process.exit(1); });

bootstrap().then(() => {
  server.listen(CFG.port, CFG.host, () => console.log(`PharmaDawa running at http://${CFG.host}:${CFG.port}`));
}).catch((e) => { console.error('Startup failed:', e); process.exit(1); });
