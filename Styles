:root {
  --pine: #123d33; --pine-2: #1d5546; --mint: #e6f1ec; --paper: #f6f8f6; --card: #fff;
  --ink: #1b2622; --muted: #5d6b65; --line: #d8dfda;
  --ok: #1f7a55; --warn: #9a5b00; --bad: #b3261e;
  --ok-bg: #e2f3ea; --warn-bg: #fdf0d6; --bad-bg: #fbe4e2;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --pine: #0c2a23; --pine-2: #1d5546; --mint: #1a2e27; --paper: #101815; --card: #17211d;
    --ink: #e8efeb; --muted: #9fb0a8; --line: #2b3a34;
    --ok: #6fd1a5; --warn: #f0b95a; --bad: #ff8d84;
    --ok-bg: #173627; --warn-bg: #3a2c10; --bad-bg: #3d1d1a;
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body { font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--paper); color: var(--ink); }
h1, h2 { line-height: 1.2; margin: 0; }
h2 { font-size: 1.1rem; }
:focus-visible { outline: 3px solid var(--pine-2); outline-offset: 2px; }
.muted { color: var(--muted); font-size: .875rem; }
.note { color: var(--muted); margin: .75rem 0; }
.note.small { font-size: .8rem; }
.num { text-align: right; font-variant-numeric: tabular-nums; }

/* buttons, inputs, badges */
.btn { font: inherit; padding: .55rem 1rem; border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 8px; cursor: pointer; }
.btn:hover:not(:disabled) { border-color: var(--pine-2); }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn.primary { background: var(--pine-2); border-color: var(--pine-2); color: #fff; font-weight: 600; }
.btn.danger { background: var(--bad); border-color: var(--bad); color: #fff; }
.btn.small { padding: .25rem .6rem; font-size: .85rem; }
.btn.block { width: 100%; }
.btn.grow { flex: 1; }
input, select { font: inherit; padding: .55rem .7rem; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink); min-width: 0; }
.search { flex: 1; min-width: 200px; }
.badge { display: inline-block; padding: .1rem .55rem; border-radius: 999px; font-size: .8rem; background: var(--mint); color: var(--ink); }
.badge.ok { background: var(--ok-bg); color: var(--ok); }
.badge.warn { background: var(--warn-bg); color: var(--warn); }
.badge.bad { background: var(--bad-bg); color: var(--bad); }
.field { display: grid; gap: .25rem; margin-bottom: .9rem; }
.field small { color: var(--muted); }
.form-error { color: var(--bad); margin: .5rem 0; min-height: 1.2em; }
.logo { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 10px; background: var(--pine-2); color: #fff; font-weight: 700; }

/* login */
.login-wrap { min-height: 100%; display: grid; place-items: center; padding: 1rem; background: var(--pine); }
.login-card { width: min(380px, 100%); background: var(--card); padding: 2rem; border-radius: 16px; display: grid; gap: .25rem; }
.login-card .sub { margin: 0 0 1rem; color: var(--muted); }

/* shell */
.app { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
.sidebar { background: var(--pine); color: #fff; padding: 1rem; }
.brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; margin-bottom: 1.5rem; }
.sidebar nav { display: grid; gap: .25rem; }
.nav-btn { text-align: left; font: inherit; color: #cfe3da; background: none; border: 0; padding: .6rem .8rem; border-radius: 8px; cursor: pointer; }
.nav-btn:hover { background: rgba(255,255,255,.08); }
.nav-btn[aria-current="page"] { background: rgba(255,255,255,.16); color: #fff; font-weight: 600; }
.main { min-width: 0; display: flex; flex-direction: column; }
.topbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem; padding: .9rem 1.25rem; background: var(--card); border-bottom: 1px solid var(--line); }
.top-right { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
.clock { color: var(--muted); font-variant-numeric: tabular-nums; }
.view { padding: 1.25rem; }
.toolbar { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }

/* point of sale */
.pos { display: grid; grid-template-columns: 1fr 340px; gap: 1.25rem; align-items: start; }
.catalog { display: grid; gap: 1rem; min-width: 0; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: .75rem; }
.card { text-align: left; font: inherit; color: inherit; display: grid; gap: .2rem; align-content: start; padding: .8rem; background: var(--card); border: 1px solid var(--line); border-radius: 12px; cursor: pointer; }
.card:hover:not(:disabled) { border-color: var(--pine-2); }
.card.off { opacity: .55; cursor: not-allowed; }
.price { font-weight: 700; color: var(--pine-2); }
.cart { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1rem; position: sticky; top: 1rem; display: grid; gap: .5rem; }
.lines { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
.line { display: grid; grid-template-columns: 1fr auto; gap: .25rem .5rem; padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
.line-name { display: grid; }
.line-total { text-align: right; font-variant-numeric: tabular-nums; }
.qty { display: flex; gap: .25rem; align-items: center; }
.qty input { width: 3.6rem; text-align: center; padding: .25rem; }
.sum-row { display: flex; justify-content: space-between; }
.sum-row.total { font-weight: 700; font-size: 1.15rem; border-top: 1px solid var(--line); padding-top: .5rem; margin-top: .25rem; }
.actions { display: flex; gap: .5rem; margin-top: .5rem; }
.actions.end { justify-content: flex-end; }

/* tables */
.table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: .65rem .8rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-size: .85rem; color: var(--muted); font-weight: 600; }
tr:last-child td { border-bottom: 0; }
.row-actions { white-space: nowrap; display: flex; gap: .35rem; }

/* dialogs and toasts */
.modal { border: 0; border-radius: 14px; padding: 1.5rem; width: min(440px, calc(100% - 2rem)); background: var(--card); color: var(--ink); }
.modal::backdrop { background: rgba(0,0,0,.45); }
.modal h2 { margin-bottom: 1rem; }
#toasts { position: fixed; right: 1rem; bottom: 1rem; display: grid; gap: .5rem; z-index: 50; max-width: min(380px, calc(100% - 2rem)); }
.toast { background: var(--pine); color: #fff; padding: .7rem 1rem; border-radius: 10px; }
.toast.error { background: var(--bad); }
.toast.success { background: var(--ok); color: #fff; }

@media (max-width: 860px) {
  .app { grid-template-columns: 1fr; }
  .sidebar { display: flex; align-items: center; gap: 1rem; padding: .6rem 1rem; overflow-x: auto; }
  .brand { margin: 0; }
  .sidebar nav { display: flex; }
  .pos { grid-template-columns: 1fr; }
  .cart { position: static; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
