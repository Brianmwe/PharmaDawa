// Admin: Void a sale
async function voidSale(saleId) {
  if (!confirm('Are you sure you want to void this sale and restore inventory?')) return;
  
  try {
    const result = await apiRequest(`/sales/${saleId}/void`, {
      method: 'POST'
    });
    alert(result.message);
  } catch (err) {
    alert(`Void failed: ${err.message}`);
  }
}
// Backend: GET /api/medicines?search=paracetamol&page=1&limit=20
app.get('/api/medicines', authenticateToken, (req, res) => {
  const { search = '', page = 1, limit = 20 } = req.query;
  const offset = (page - 1) * limit;

  const medicines = db.prepare(`
    SELECT * FROM medicines 
    WHERE name LIKE ? 
    LIMIT ? OFFSET ?
  `).all(`%${search}%`, Number(limit), Number(offset));

  res.json(medicines);
});
