/**
 * pharmadawa-api.js: the single fetch layer for the Pharmadawa frontend.
 *
 * Load it before any other script:  <script src="pharmadawa-api.js"></script>
 * It never shows alerts or touches the page (except the optional spinner).
 * Every function returns data or throws an ApiError; the calling code decides
 * how to display the message (use textContent, never innerHTML, for error text).
 *
 * Client-side checks here are for safety and convenience only. The server must
 * enforce the same rules, because anyone can bypass this file.
 */

const PharmaAPI = (() => {
  'use strict';

  const BASE_URL = 'http://localhost:3000/api'; // production: use your https:// API URL
  const TOKEN_KEY = 'pharmadawa_token';
  const LOGIN_PAGE = '/login.html';
  const TIMEOUT_MS = 15000;

  // ---------- Errors ----------
  class ApiError extends Error {
    constructor(message, status = 0) {
      super(message);
      this.name = 'ApiError';
      this.status = status;
    }
  }

  // ---------- Token storage ----------
  const getToken = () => {
    try { return localStorage.getItem(TOKEN_KEY); } catch { return null; }
  };
  const setToken = (token) => {
    try { localStorage.setItem(TOKEN_KEY, token); } catch { /* storage blocked */ }
  };
  const clearToken = () => {
    try { localStorage.removeItem(TOKEN_KEY); } catch { /* storage blocked */ }
  };

  // ---------- Loading spinner (counts overlapping requests) ----------
  let pending = 0;
  function setLoading(on) {
    pending = Math.max(0, pending + (on ? 1 : -1));
    const el = document.getElementById('loading-spinner');
    if (el) el.style.display = pending > 0 ? 'block' : 'none';
  }

  // ---------- Input helpers ----------
  function toPositiveInt(value, label) {
    const n = Number(value);
    if (!Number.isSafeInteger(n) || n <= 0) {
      throw new ApiError(`${label} must be a positive whole number`, 400);
    }
    return n;
  }

  function clampInt(value, min, max, fallback) {
    const n = Math.floor(Number(value));
    return Number.isFinite(n) ? Math.min(Math.max(n, min), max) : fallback;
  }

  // Blocks double-clicks: the same action can't run twice at once
  const busy = new Set();
  async function once(key, fn) {
    if (busy.has(key)) throw new ApiError('Please wait, this request is already in progress.', 0);
    busy.add(key);
    try { return await fn(); } finally { busy.delete(key); }
  }

  // ---------- Core request ----------
  async function request(endpoint, { method = 'GET', body, auth = true } = {}) {
    if (typeof endpoint !== 'string' || !endpoint.startsWith('/')) {
      throw new ApiError('Invalid endpoint', 400);
    }

    const headers = { Accept: 'application/json' };
    if (body !== undefined) headers['Content-Type'] = 'application/json';
    const token = auth ? getToken() : null;
    if (token) headers.Authorization = `Bearer ${token}`;

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    setLoading(true);

    try {
      let res;
      try {
        res = await fetch(BASE_URL + endpoint, {
          method,
          headers,
          body: body !== undefined ? JSON.stringify(body) : undefined,
          signal: controller.signal,
          cache: 'no-store', // never serve stock or sales data from the browser cache
        });
      } catch (err) {
        throw new ApiError(
          err.name === 'AbortError'
            ? 'The request timed out. Please try again.'
            : 'Cannot reach the server. Check your connection.'
        );
      }

      let data = null;
      try { data = await res.json(); } catch { /* server sent no JSON (e.g. a proxy error page) */ }

      // 401 = missing, invalid, or expired login. (A wrong password on /login is not an expired session.)
      if (res.status === 401 && auth) {
        clearToken();
        if (!location.pathname.endsWith(LOGIN_PAGE)) location.replace(LOGIN_PAGE);
        throw new ApiError('Session expired. Please log in again.', 401);
      }

      // 403 = logged in but not allowed (e.g. a cashier on an admin action). Keep the session.
      if (res.status === 403) {
        throw new ApiError(data?.error || 'You do not have permission to do that.', 403);
      }

      if (!res.ok) throw new ApiError(data?.error || `Request failed (${res.status})`, res.status);
      return data;
    } finally {
      clearTimeout(timer);
      setLoading(false);
    }
  }

  // ---------- Auth ----------
  async function login(username, password) {
    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !password) {
      throw new ApiError('Enter your username and password', 400);
    }
    const data = await once('login', () =>
      request('/login', { method: 'POST', body: { username: username.trim(), password }, auth: false })
    );
    if (typeof data?.token !== 'string' || !data.token) {
      throw new ApiError('Login failed: invalid server response', 500);
    }
    setToken(data.token);
    return data;
  }

  function logout() {
    clearToken();
    location.replace(LOGIN_PAGE);
  }

  const isLoggedIn = () => Boolean(getToken());

  // ---------- Medicines ----------
  function searchMedicines({ search = '', page = 1, limit = 20 } = {}) {
    const params = new URLSearchParams();
    const term = String(search).trim().slice(0, 100);
    if (term) params.set('search', term);
    params.set('page', clampInt(page, 1, 100000, 1));
    params.set('limit', clampInt(limit, 1, 100, 20));
    return request(`/medicines?${params}`);
  }

  // Admin only (the server enforces this)
  function restockMedicine(medicineId, quantity) {
    const id = toPositiveInt(medicineId, 'Medicine ID');
    const qty = toPositiveInt(quantity, 'Quantity');
    return once(`restock:${id}`, () =>
      request(`/medicines/${id}/restock`, { method: 'PATCH', body: { quantity: qty } })
    );
  }

  // ---------- Sales ----------
  // Sends only medicine IDs and quantities. Prices and totals are always set by the server.
  function checkout(cartItems) {
    if (!Array.isArray(cartItems) || cartItems.length === 0) {
      throw new ApiError('Cart is empty', 400);
    }

    // Validate every line and merge duplicates so the same medicine can't be split across lines
    const merged = new Map();
    for (const item of cartItems) {
      const id = toPositiveInt(item?.medicine_id, 'Medicine ID');
      const qty = toPositiveInt(item?.quantity, 'Quantity');
      merged.set(id, (merged.get(id) || 0) + qty);
    }
    const items = [...merged].map(([medicine_id, quantity]) => ({ medicine_id, quantity }));

    return once('checkout', () => request('/sales', { method: 'POST', body: { items } }));
  }

  function getSale(saleId) {
    return request(`/sales/${toPositiveInt(saleId, 'Sale ID')}`);
  }

  // Admin only (the server enforces this). Ask for confirmation in your UI before calling.
  function voidSale(saleId) {
    const id = toPositiveInt(saleId, 'Sale ID');
    return once(`void:${id}`, () => request(`/sales/${id}/void`, { method: 'POST' }));
  }

  return Object.freeze({
    ApiError,
    login,
    logout,
    isLoggedIn,
    searchMedicines,
    restockMedicine,
    checkout,
    getSale,
    voidSale,
  });
})();
