// Restock without resending the whole medicine
app.patch('/api/medicines/:id/restock', authenticateToken, requireAdmin, (req, res) => {
  const qty = req.body.quantity;
  if (!Number.isInteger(qty) || qty <= 0) {
    return res.status(400).json({ error: 'Quantity must be a positive whole number' });
  }
  const r = db.prepare('UPDATE medicines SET stock = stock + ? WHERE id = ?').run(qty, req.params.id);
  if (r.changes === 0) return res.status(404).json({ error: 'Medicine not found' });
  res.json(db.prepare('SELECT * FROM medicines WHERE id = ?').get(req.params.id));
});

// Single sale for receipts
app.get('/api/sales/:id', authenticateToken, (req, res) => {
  const sale = db.prepare('SELECT * FROM sales WHERE id = ?').get(req.params.id);
  if (!sale) return res.status(404).json({ error: 'Sale not found' });
  sale.items = db.prepare(`
    SELECT si.quantity, si.price, m.name AS medicine_name
    FROM sale_items si JOIN medicines m ON si.medicine_id = m.id
    WHERE si.sale_id = ?`).all(sale.id);
  res.json(sale);
});

// Void a sale and put stock back
const voidSale = db.transaction((id) => {
  const sale = db.prepare('SELECT * FROM sales WHERE id = ?').get(id);
  if (!sale) throw new Error('Sale not found');
  if (sale.voided) throw new Error('Sale already voided');
  const items = db.prepare('SELECT medicine_id, quantity FROM sale_items WHERE sale_id = ?').all(id);
  const restock = db.prepare('UPDATE medicines SET stock = stock + ? WHERE id = ?');
  items.forEach(i => restock.run(i.quantity, i.medicine_id));
  db.prepare('UPDATE sales SET voided = 1 WHERE id = ?').run(id);
});

app.post('/api/sales/:id/void', authenticateToken, requireAdmin, (req, res) => {
  try {
    voidSale(req.params.id);
    res.json({ message: 'Sale voided and stock restored' });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});
// Create a new sale and deduct stock (wrapped in a transaction)
const createSale = db.transaction((items) => {
  // 1. Insert into sales table
  const saleInfo = db.prepare('INSERT INTO sales (created_at) VALUES (CURRENT_TIMESTAMP)').run();
  const saleId = saleInfo.lastInsertRowid;

  const insertItem = db.prepare('INSERT INTO sale_items (sale_id, medicine_id, quantity, price) VALUES (?, ?, ?, ?)');
  const updateStock = db.prepare('UPDATE medicines SET stock = stock - ? WHERE id = ?');
  const getMedicine = db.prepare('SELECT stock, price FROM medicines WHERE id = ?');

  for (const item of items) {
    const med = getMedicine.get(item.medicine_id);
    if (!med) throw new Error(`Medicine ID ${item.medicine_id} not found`);
    if (med.stock < item.quantity) throw new Error(`Insufficient stock for medicine ID ${item.medicine_id}`);

    // Update stock and insert sale item
    updateStock.run(item.quantity, item.medicine_id);
    insertItem.run(saleId, item.medicine_id, item.quantity, med.price);
  }
  return saleId;
});

app.post('/api/sales', authenticateToken, (req, res) => {
  try {
    const { items } = req.body;
    if (!items || !Array.isArray(items) || items.length === 0) {
      return res.status(400).json({ error: 'Cart is empty' });
    }
    const saleId = createSale(items);
    res.status(201).json({ message: 'Sale completed', saleId });
  } catch (e) {
    res.status(400).json({ error: e.message });
  }
});
