const Joi = require('joi');

// Validation Schemas
const schemas = {
  login: Joi.object({
    username: Joi.string().alphanum().min(3).max(30).required(),
    password: Joi.string().min(6).required(),
  }),
  medicine: Joi.object({
    name: Joi.string().trim().min(2).max(100).required(),
