'use strict';

// Integration tests for the PharmaDawa API. Needs Node 18+ (global fetch).
const { spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const PORT = Number(process.env.TEST_PORT) || 3999;
const BASE = `http://127.0.0.1:${PORT}`;
const DB_FILE = path.join(os.tmpdir(), `pharmadawa-test-${process.pid}-${Date.now()}.db`);
const ADMIN_PASSWORD = 'TestPass#12345';
const TAX_RATE = 0.05;

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const round2 = (n) => Math.round(n * 100) / 100;

let passed = 0;
let failed = 0;

function check(name, condition, extra = '') {
  if (condition) {
    passed++;
    console.log(`  PASS  ${name}`);
  } else {
    failed++;
    console.log(`  FAIL  ${name} ${extra}`);
  }
}

async function api(method, url, { token, body, raw } = {}) {
  const headers = {};
  let payload;

  if (token) headers.Authorization = `Bearer ${token}`;

  if (raw !== undefined) {
    payload = raw;
    headers['Content-Type'] = 'application/json';
  } else if (body !== undefined) {
    payload = JSON.stringify(body);
    headers['Content-Type'] = 'application/json';
  }

  const res = await fetch(BASE + url, {
    method,
    headers,
    body: payload,
    signal: AbortSignal.timeout(10000),
  });

  const type = res.headers.get('content-type') || '';
  const data = type.includes('json')
    ? await res.json().catch(() => null)
    : Buffer.from(await res.arrayBuffer());

  return { status: res.status, data, type };
}

const login = (username, password) =>
  api('POST', '/api/auth/login', { body: { username, password } });

const listMedicines = async (token) => (await api('GET', '/api/medicines', { token })).data;

async function testAuth() {
  console.log('Health & auth');

  const health = await api('GET', '/api/health');
  check('health ok', health.data?.status === 'ok');

  const noToken = await api('GET', '/api/medicines');
  check('no token -> 401', noToken.status === 401);

  const wrongPassword = await login('admin', 'wrongpass');
  check('wrong password -> 401', wrongPassword.status === 401);

  const adminLogin = await login('admin', ADMIN_PASSWORD);
  check('admin login', adminLogin.status === 200 && !!adminLogin.data?.token);

  const legacy = await api('POST', '/api/login', {
    body: { username: 'admin', password: ADMIN_PASSWORD },
  });
  check('legacy /api/login alias works', legacy.status === 200);

  const badJson = await api('POST', '/api/auth/login', { raw: '{bad json' });
  check('malformed JSON -> 400', badJson.status === 400);

  return adminLogin.data.token;
}

async function testInventory(admin) {
  console.log('Inventory');

  const meds = await listMedicines(admin);
  check('6 seeded medicines', meds.length === 6, `(got ${meds.length})`);

  const para = meds.find((m) => m.name.startsWith('Paracetamol'));
  const ibu = meds.find((m) => m.name.startsWith('Ibuprofen'));
  if (!para || !ibu) throw new Error('Seed data missing Paracetamol/Ibuprofen');

  const search = await api('GET', '/api/medicines?q=paracet', { token: admin });
  check('search works', search.data.length === 1);

  const badId = await api('PUT', '/api/medicines/abc', { token: admin, body: {} });
  check('bad id -> 400', badId.status === 400);

  const base = { name: 'Test', category: 'X', price: 5, stock: 1 };

  const badDate = await api('POST', '/api/medicines', {
    token: admin,
    body: { ...base, expiry: '2030-02-31' },
  });
  check('impossible date rejected', badDate.status === 400);

  const expired = await api('POST', '/api/medicines', {
    token: admin,
    body: { ...base, expiry: '2020-01-01' },
  });
  check('already-expired stock rejected', expired.status === 400);

  const created = await api('POST', '/api/medicines', {
    token: admin,
    body: { ...base, expiry: '2035-01-01', barcode: 'BC-1' },
  });
  check('create medicine', created.status === 201);

  const duplicate = await api('POST', '/api/medicines', {
    token: admin,
    body: { ...base, name: 'Test2', expiry: '2035-01-01', barcode: 'BC-1' },
  });
  check('duplicate barcode -> 409', duplicate.status === 409);

  const barcode = await api('GET', '/api/medicines/barcode/BC-1', { token: admin });
  check('barcode lookup + sellable flag', barcode.status === 200 && barcode.data.sellable === true);

  return { para, ibu, base, created: created.data };
}

async function testSales(admin, { para, ibu }) {
  console.log('Sales');

  const quantity = 2;
  const sale = await api('POST', '/api/sales', {
    token: admin,
    body: { items: [{ medicineId: para.id, quantity, price: 0.01 }] },
  });
  check('sale created', sale.status === 201);

  const subtotal = round2(para.price * quantity);
  const tax = round2(subtotal * TAX_RATE);
  const total = round2(subtotal + tax);
  check(
    `client price ignored (${subtotal.toFixed(2)} + ${tax.toFixed(2)} = ${total.toFixed(2)})`,
    sale.data?.sale?.subtotal === subtotal &&
      sale.data.sale.tax === tax &&
      sale.data.sale.total === total,
    JSON.stringify(sale.data?.sale)
  );

  const saleId = sale.data.sale.saleId;

  const paraAfter = (await listMedicines(admin)).find((m) => m.id === para.id);
  check('stock deducted', paraAfter.stock === para.stock - quantity);

  const oversell = await api('POST', '/api/sales', {
    token: admin,
    body: { items: [{ medicineId: ibu.id, quantity: ibu.stock + 1 }] },
  });
  check('oversell blocked', oversell.status === 400);

  const half = Math.floor(ibu.stock / 2) + 1;
  const splitOversell = await api('POST', '/api/sales', {
    token: admin,
    body: {
      items: [
        { medicineId: ibu.id, quantity: half },
        { medicineId: ibu.id, quantity: half },
      ],
    },
  });
  check('split-line oversell blocked', splitOversell.status === 400);

  const ibuAfter = (await listMedicines(admin)).find((m) => m.id === ibu.id);
  check('failed sales left stock untouched', ibuAfter.stock === ibu.stock);

  const receipt = await api('GET', `/api/sales/${saleId}/receipt`, { token: admin });
  check(
    'receipt is a PDF',
    receipt.type.includes('application/pdf') && receipt.data.subarray(0, 4).toString() === '%PDF'
  );

  return saleId;
}

async function testVoidAndExpiry(admin, { para, base, created }, saleId) {
  console.log('Void & expiry');

  const voided = await api('POST', `/api/sales/${saleId}/void`, {
    token: admin,
    body: { reason: 'Customer returned' },
  });
  check('void sale', voided.status === 200);

  const restored = (await listMedicines(admin)).find((m) => m.id === para.id);
  check('stock restored after void', restored.stock === para.stock);

  const voidAgain = await api('POST', `/api/sales/${saleId}/void`, {
    token: admin,
    body: { reason: 'Again please' },
  });
  check('double void -> 409', voidAgain.status === 409);

  const expire = await api('PUT', `/api/medicines/${created.id}`, {
    token: admin,
    body: { ...base, expiry: '2020-01-01', barcode: 'BC-1' },
  });
  check('can mark existing item expired (setup)', expire.status === 200, `(got ${expire.status})`);

  const sellExpired = await api('POST', '/api/sales', {
    token: admin,
    body: { items: [{ medicineId: created.id, quantity: 1 }] },
  });
  check('expired item cannot be sold', sellExpired.status === 400);

  const restock = await api('POST', `/api/medicines/${para.id}/restock`, {
    token: admin,
    body: { quantity: 10 },
  });
  check('restock adds relative stock', restock.data?.stock === para.stock + 10);
}

async function testRolesAndSessions(admin, { para, base }) {
  console.log('Roles & sessions');

  const newUser = await api('POST', '/api/users', {
    token: admin,
    body: { username: 'Amina', password: 'Pharma#Pass1' },
  });
  check('create pharmacist', newUser.status === 201);

  const pharmacist = (await login('amina', 'Pharma#Pass1')).data?.token;
  check('pharmacist login (case-insensitive username)', !!pharmacist);

  const addMedicine = await api('POST', '/api/medicines', {
    token: pharmacist,
    body: { ...base, expiry: '2035-01-01' },
  });
  check('pharmacist cannot add medicine -> 403', addMedicine.status === 403);

  const pharmacistSale = await api('POST', '/api/sales', {
    token: pharmacist,
    body: { items: [{ medicineId: para.id, quantity: 1 }] },
  });
  check('pharmacist can sell', pharmacistSale.status === 201);

  const changePassword = await api('POST', '/api/auth/change-password', {
    token: pharmacist,
    body: { currentPassword: 'Pharma#Pass1', newPassword: 'NewPharma#Pass2' },
  });
  check('change password', changePassword.status === 200 && !!changePassword.data?.token);

  const oldToken = await api('GET', '/api/medicines', { token: pharmacist });
  check('old token revoked after password change', oldToken.status === 401);

  const newToken = changePassword.data.token;
  const withNewToken = await api('GET', '/api/medicines', { token: newToken });
  check('new token works', withNewToken.status === 200);

  const users = (await api('GET', '/api/users', { token: admin })).data;
  const adminId = users.find((u) => u.username === 'admin').id;
  const deleteSelf = await api('DELETE', `/api/users/${adminId}`, { token: admin });
  check('cannot delete self', deleteSelf.status === 400);

  const stats = await api('GET', '/api/dashboard/stats', { token: admin });
  check('dashboard stats', stats.data?.success === true);

  const auditAsAdmin = await api('GET', '/api/audit-logs', { token: admin });
  check('audit log readable by admin', auditAsAdmin.status === 200);

  const auditAsPharmacist = await api('GET', '/api/audit-logs', { token: newToken });
  check('audit log forbidden for pharmacist', auditAsPharmacist.status === 403);

  const unknown = await api('GET', '/api/nope', { token: admin });
  check('unknown route -> 404 JSON', unknown.status === 404);
}

async function testBruteForce() {
  console.log('Brute-force protection');

  let last;
  for (let i = 0; i < 6; i++) {
    last = await login('locktest', 'badbadbad');
  }
  check('account locked after repeated failures (429)', last.status === 429, `(got ${last.status})`);
}

async function run() {
  const admin = await testAuth();
  const inventory = await testInventory(admin);
  const saleId = await testSales(admin, inventory);
  await testVoidAndExpiry(admin, inventory, saleId);
  await testRolesAndSessions(admin, inventory);
  await testBruteForce();
}

async function waitForServer(server, timeoutMs = 10000) {
  const start = Date.now();

  while (Date.now() - start < timeoutMs) {
    if (server.exitCode !== null) {
      throw new Error(`Server exited early with code ${server.exitCode}`);
    }
    try {
      const res = await fetch(`${BASE}/api/health`, { signal: AbortSignal.timeout(1000) });
      if (res.ok) return;
    } catch {
      // server not up yet
    }
    await sleep(200);
  }

  throw new Error('Server did not become healthy in time');
}

async function main() {
  const server = spawn(process.execPath, [path.join(__dirname, 'server.js')], {
    env: {
      ...process.env,
      PORT: String(PORT),
      DB_PATH: DB_FILE,
      ADMIN_PASSWORD,
      JWT_SECRET: 'x'.repeat(40),
      NODE_ENV: 'test',
    },
    stdio: ['ignore', 'pipe', 'pipe'],
  });

  let serverLog = '';
  server.stdout.on('data', (chunk) => (serverLog += chunk));
  server.stderr.on('data', (chunk) => (serverLog += chunk));

  try {
    await waitForServer(server);
    await run();
  } catch (error) {
    failed++;
    console.log('  ERROR', error.stack || error);
  } finally {
    server.kill('SIGTERM');
    await sleep(500);
    for (const file of [DB_FILE, `${DB_FILE}-wal`, `${DB_FILE}-shm`]) {
      fs.rmSync(file, { force: true });
    }
  }

  console.log(`\n${passed} passed, ${failed} failed`);
  if (failed) console.log(`\nServer log:\n${serverLog}`);
  process.exitCode = failed ? 1 : 0;
}

main();
