// 3. POST /api/sales - Process sale, deduct stock, & create invoice record
app.post('/api/sales', (req, res) => {
  const { items } = req.body;

  if (!items || !Array.isArray(items) || items.length === 0) {
    return res.status(400).json({ error: 'Cart items are required' });
  }

  // Use an atomic transaction for database consistency
  const processSale = db.transaction((cartItems) => {
    let subtotal = 0;

    // Verify stock and calculate subtotal
    for (const item of cartItems) {
      const med = db.prepare('SELECT * FROM medicines WHERE id = ?').get(item.medicineId);
      if (!med) throw new Error(`Medicine with ID ${item.medicineId} not found`);
      if (med.stock < item.quantity) {
        throw new Error(`Insufficient stock for ${med.name}. Available: ${med.stock}`);
      }
      subtotal += med.price * item.quantity;
    }

    const tax = subtotal * 0.05;
    const total = subtotal + tax;

    // Create sales master record
    const saleResult = db.prepare(
      'INSERT INTO sales (subtotal, tax, total) VALUES (?, ?, ?)'
    ).run(subtotal, tax, total);

    const saleId = saleResult.lastInsertRowid;

    // Insert sale items & deduct inventory stock
    const insertItem = db.prepare(
      'INSERT INTO sale_items (sale_id, medicine_id, quantity, price) VALUES (?, ?, ?, ?)'
    );
    const updateStock = db.prepare(
      'UPDATE medicines SET stock = stock - ? WHERE id = ?'
    );

    for (const item of cartItems) {
      insertItem.run(saleId, item.medicineId, item.quantity, item.price);
      updateStock.run(item.quantity, item.medicineId);
    }

    return { saleId, subtotal, tax, total };
  });

  try {
    const saleData = processSale(items);
    res.status(201).json({
      message: 'PharmaDawa sale completed successfully!',
      sale: saleData
    });
  } catch (error) {
    res.status(400).json({ error: error.message });
  }
});

