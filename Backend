const { spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const PORT = 3999;
const BASE = `http://127.0.0.1:${PORT}`;
const DB = path.join(os.tmpdir(), `pharmadawa-test-${Date.now()}.db`);
const ADMIN_PW = 'TestPass#12345';

let passed = 0, failed = 0;
const check = (name, cond, extra = '') => {
  if (cond) { passed++; console.log(`  PASS  ${name}`); }
  else { failed++; console.log(`  FAIL  ${name} ${extra}`); }
};
async function api(method, url, { token, body, raw } = {}) {
  const res = await fetch(BASE + url, {
    method,
    headers: { ...(body !== undefined && !raw ? { 'Content-Type': 'application/json' } : {}), ...(raw ? { 'Content-Type': 'application/json' } : {}), ...(token ? { Authorization: `Bearer ${token}` } : {}) },
    body: raw ?? (body !== undefined ? JSON.stringify(body) : undefined),
  });
  const type = res.headers.get('content-type') || '';
  const data = type.includes('json') ? await res.json() : Buffer.from(await res.arrayBuffer());
  return { status: res.status, data, type };
}

async function run() {
  console.log('Health & auth');
  check('health ok', (await api('GET', '/api/health')).data.status === 'ok');
  check('no token -> 401', (await api('GET', '/api/medicines')).status === 401);
  check('wrong password -> 401', (await api('POST', '/api/auth/login', { body: { username: 'admin', password: 'wrongpass' } })).status === 401);
  const login = await api('POST', '/api/auth/login', { body: { username: 'admin', password: ADMIN_PW } });
  check('admin login', login.status === 200 && !!login.data.token);
  const admin = login.data.token;
  check('legacy /api/login alias works', (await api('POST', '/api/login', { body: { username: 'admin', password: ADMIN_PW } })).status === 200);
  check('malformed JSON -> 400', (await api('POST', '/api/auth/login', { raw: '{bad json' })).status === 400);

  console.log('Inventory');
  const meds = (await api('GET', '/api/medicines', { token: admin })).data;
  check('6 seeded medicines', meds.length === 6);
  const para = meds.find(m => m.name.startsWith('Paracetamol'));
  const ibu = meds.find(m => m.name.startsWith('Ibuprofen'));
  check('search works', (await api('GET', '/api/medicines?q=paracet', { token: admin })).data.length === 1);
  check('bad id -> 400', (await api('PUT', '/api/medicines/abc', { token: admin, body: {} })).status === 400);
  const badDate = { name: 'Test', category: 'X', price: 5, stock: 1, expiry: '2030-02-31' };
  check('impossible date rejected', (await api('POST', '/api/medicines', { token: admin, body: badDate })).status === 400);
  check('already-expired stock rejected', (await api('POST', '/api/medicines', { token: admin, body: { ...badDate, expiry: '2020-01-01' } })).status === 400);
  const created = await api('POST', '/api/medicines', { token: admin, body: { ...badDate, expiry: '2035-01-01', barcode: 'BC-1' } });
  check('create medicine', created.status === 201);
  check('duplicate barcode -> 409', (await api('POST', '/api/medicines', { token: admin, body: { ...badDate, name: 'Test2', expiry: '2035-01-01', barcode: 'BC-1' } })).status === 409);
  const bc = await api('GET', '/api/medicines/barcode/BC-1', { token: admin });
  check('barcode lookup + sellable flag', bc.status === 200 && bc.data.sellable === true);

  console.log('Sales');
  const sale = await api('POST', '/api/sales', { token: admin, body: { items: [{ medicineId: para.id, quantity: 2, price: 0.01 }] } });
  check('sale created', sale.status === 201);
  check('client price ignored (8.00 + 0.40 = 8.40)', sale.data.sale.subtotal === 8 && sale.data.sale.tax === 0.4 && sale.data.sale.total === 8.4);
  const after = (await api('GET', '/api/medicines', { token: admin })).data.find(m => m.id === para.id);
  check('stock deducted', after.stock === para.stock - 2);
  check('oversell blocked', (await api('POST', '/api/sales', { token: admin, body: { items: [{ medicineId: ibu.id, quantity: 9 }] } })).status === 400);
  check('split-line oversell blocked', (await api('POST', '/api/sales', { token: admin, body: { items: [{ medicineId: ibu.id, quantity: 5 }, { medicineId: ibu.id, quantity: 5 }] } })).status === 400);
  const ibuAfter = (await api('GET', '/api/medicines', { token: admin })).data.find(m => m.id === ibu.id);
  check('failed sales left stock untouched', ibuAfter.stock === ibu.stock);
  const rcpt = await api('GET', `/api/sales/${sale.data.sale.saleId}/receipt`, { token: admin });
  check('receipt is a PDF', rcpt.type.includes('application/pdf') && rcpt.data.slice(0, 4).toString() === '%PDF');

  console.log('Void & expiry');
  check('void sale', (await api('POST', `/api/sales/${sale.data.sale.saleId}/void`, { token: admin, body: { reason: 'Customer returned' } })).status === 200);
  const restored = (await api('GET', '/api/medicines', { token: admin })).data.find(m => m.id === para.id);
  check('stock restored after void', restored.stock === para.stock);
  check('double void -> 409', (await api('POST', `/api/sales/${sale.data.sale.saleId}/void`, { token: admin, body: { reason: 'Again please' } })).status === 409);
  await api('PUT', `/api/medicines/${created.data.id}`, { token: admin, body: { ...badDate, expiry: '2020-01-01', barcode: 'BC-1' } });
  check('expired item cannot be sold', (await api('POST', '/api/sales', { token: admin, body: { items: [{ medicineId: created.data.id, quantity: 1 }] } })).status === 400);
  check('restock adds relative stock', (await api('POST', `/api/medicines/${para.id}/restock`, { token: admin, body: { quantity: 10 } })).data.stock === para.stock + 10);

  console.log('Roles & sessions');
  check('create pharmacist', (await api('POST', '/api/users', { token: admin, body: { username: 'Amina', password: 'Pharma#Pass1' } })).status === 201);
  const ph = (await api('POST', '/api/auth/login', { body: { username: 'amina', password: 'Pharma#Pass1' } })).data.token;
  check('pharmacist login (case-insensitive username)', !!ph);
  check('pharmacist cannot add medicine -> 403', (await api('POST', '/api/medicines', { token: ph, body: { ...badDate, expiry: '2035-01-01' } })).status === 403);
  check('pharmacist can sell', (await api('POST', '/api/sales', { token: ph, body: { items: [{ medicineId: para.id, quantity: 1 }] } })).status === 201);
  const cp = await api('POST', '/api/auth/change-password', { token: ph, body: { currentPassword: 'Pharma#Pass1', newPassword: 'NewPharma#Pass2' } });
  check('change password', cp.status === 200 && !!cp.data.token);
  check('old token revoked after password change', (await api('GET', '/api/medicines', { token: ph })).status === 401);
  check('new token works', (await api('GET', '/api/medicines', { token: cp.data.token })).status === 200);
  const adminId = (await api('GET', '/api/users', { token: admin })).data.find(u => u.username === 'admin').id;
  check('cannot delete self', (await api('DELETE', `/api/users/${adminId}`, { token: admin })).status === 400);
  check('dashboard stats', (await api('GET', '/api/dashboard/stats', { token: admin })).data.success === true);
  check('audit log readable by admin only', (await api('GET', '/api/audit-logs', { token: admin })).status === 200 && (await api('GET', '/api/audit-logs', { token: cp.data.token })).status === 403);
  check('unknown route -> 404 JSON', (await api('GET', '/api/nope', { token: admin })).status === 404);

  console.log('Brute-force protection');
  let last;
  for (let i = 0; i < 6; i++) last = await api('POST', '/api/auth/login', { body: { username: 'locktest', password: 'badbadbad' } });
  check('account locked after repeated failures (429)', last.status === 429);
}

(async () => {
  const server = spawn(process.execPath, [path.join(__dirname, 'server.js')], {
    env: { ...process.env, PORT: String(PORT), DB_PATH: DB, ADMIN_PASSWORD: ADMIN_PW, JWT_SECRET: 'x'.repeat(40), NODE_ENV: 'test' },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  let log = '';
  server.stdout.on('data', d => (log += d));
  server.stderr.on('data', d => (log += d));
  try {
    for (let i = 0; i < 50; i++) { // wait for startup
      try { if ((await fetch(`${BASE}/api/health`)).ok) break; } catch {}
      await new Promise(r => setTimeout(r, 200));
    }
    await run();
  } catch (e) {
    failed++; console.log('  ERROR', e.stack || e);
  } finally {
    server.kill('SIGTERM');
    await new Promise(r => setTimeout(r, 500));
    for (const f of [DB, `${DB}-wal`, `${DB}-shm`]) fs.rmSync(f, { force: true });
  }
  console.log(`\n${passed} passed, ${failed} failed`);
  if (failed) console.log('\nServer log:\n' + log);
  process.exit(failed ? 1 : 0);
})();
